9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" fill=\"#00b67a\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><defs><linearGradient id=\"ps-cart-half\"><stop offset=\"0%\" stop-color=\"#00b67a\"/><stop offset=\"50%\" stop-color=\"#00b67a\"/><stop offset=\"50%\" stop-color=\"#ddd\"/><stop offset=\"100%\" stop-color=\"#ddd\"/></linearGradient></defs><rect width=\"32\" height=\"32\" fill=\"url(#ps-cart-half)\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n        '</div>' +\n        '<p class=\"ps-cart-rating__text\">Validé par plus <strong>{{ rating_count }} clients</strong></p>' +\n      '</div>';\n\n    function inject() {\n      /* Cible : .free-shipping-bar (zone \"Votre livraison est gratuite\")\n         dans <cart-drawer>. Le badge sera inséré juste AVANT. */\n      var target = document.querySelector('cart-drawer .free-shipping-bar');\n      if (!target) return;\n      /* Évite double injection */\n      if (target.parentElement.querySelector('[data-ps-cart-rating]')) return;\n      /* Crée le badge depuis le HTML string */\n      var wrapper = document.createElement('div');\n      wrapper.innerHTML = BADGE_HTML;\n      var badge = wrapper.firstElementChild;\n      /* Insère AVANT la free-shipping-bar (donc tout en haut du drawer) */\n      target.parentElement.insertBefore(badge, target);\n    }\n\n    function setup() {\n      inject();\n      /* Surveille le cart-drawer pour re-injecter à chaque update\n         (Shopify re-render le contenu après add/remove item) */\n      var drawer = document.querySelector('cart-drawer');\n      if (drawer && window.MutationObserver) {\n        var obs = new MutationObserver(function() {\n          /* petit délai pour laisser le DOM se stabiliser */\n          setTimeout(inject, 50);\n        });\n        obs.observe(drawer, { childList: true, subtree: true });\n      }\n      /* Écoute aussi les events Shopify standards */\n      document.addEventListener('cart:open', inject);\n      document.addEventListener('cart:refresh', inject);\n      document.addEventListener('cart:update', inject);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', setup);\n    } else {\n      setup();\n    }\n  })();\n</script>",
