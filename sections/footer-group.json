    "custom_liquid_VghteP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Customisations Cart drawer\n  ------------------------------------------------------------\n  1. Badge Trustpilot \"Validé par 13 000 clients\" tout en haut\n     du drawer, au-dessus de \"Votre livraison est gratuite\"\n  2. Réalignement Sous-total : \"Sous-total\" et \"Taxes incluses.\"\n     alignés à gauche sur leur ligne, prix à droite sur la\n     même ligne que \"Sous-total\"\n  ------------------------------------------------------------\n  À coller dans : Theme editor → Footer → Add section\n                  → Custom Liquid\n  ------------------------------------------------------------\n  Fonctionnement :\n  - Le HTML du badge est défini en variable JS\n  - Au chargement, un script trouve .free-shipping-bar\n    (la zone \"Votre livraison est gratuite\") dans <cart-drawer>\n    et insère le badge juste AVANT\n  - MutationObserver pour re-injecter à chaque update du panier\n  - CSS pur (sans JS) pour restructurer le bloc Sous-total\n  ============================================================\n{%- endcomment -%}\n\n{%- assign rating_count = \"13 000\" -%}\n\n<style>\n  /* ===== Badge Trustpilot ===== */\n  .ps-cart-rating {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 8px;\n    padding: 0;\n    /* Le parent .drawer__scrollable a un gap-9 (36px) entre ses enfants\n       qui sépare trop le badge du texte de livraison. On le compense\n       avec un margin-bottom négatif pour resserrer l'espacement. */\n    margin-bottom: -28px;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, sans-serif;\n    line-height: 1;\n  }\n  .ps-cart-rating__stars {\n    display: inline-flex;\n    align-items: center;\n    gap: 2px;\n  }\n  .ps-cart-rating__star {\n    width: 16px;\n    height: 16px;\n    display: block;\n    flex-shrink: 0;\n  }\n  .ps-cart-rating__text {\n    font-size: 12px;\n    font-weight: 400;\n    color: #121212;\n    margin: 0;\n    white-space: nowrap;\n  }\n  .ps-cart-rating__text strong { font-weight: 700; }\n\n  /* ===== Réalignement Sous-total ===== */\n  /* Casse la grille 2 colonnes → tout sur une seule colonne empilée */\n  cart-drawer .drawer__footer-bottom .grid.grid-cols-2.gap-4 {\n    display: block !important;\n  }\n  /* Taxes incluses reste à gauche */\n  cart-drawer .drawer__footer-bottom .tax-note {\n    text-align: left;\n  }\n  /* La box .totals : flex row, \"Sous-total\" à gauche, prix à droite */\n  cart-drawer .drawer__footer-bottom .totals {\n    display: flex !important;\n    justify-content: space-between !important;\n    align-items: baseline !important;\n    place-self: stretch !important;\n    gap: 16px;\n    margin-top: 4px;\n  }\n  cart-drawer .drawer__footer-bottom .totals__subtotal {\n    text-align: left !important;\n  }\n  cart-drawer .drawer__footer-bottom .totals__subtotal-value {\n    text-align: right;\n  }\n</style>\n\n<script>\n  (function() {\n    'use strict';\n\n    /* HTML du badge en string (parsé avec innerHTML) */\n    var BADGE_HTML =\n      '<div class=\"ps-cart-rating\" data-ps-cart-rating>' +\n        '<div class=\"ps-cart-rating__stars\">' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" fill=\"#00b67a\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" fill=\"#00b67a\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" fill=\"#00b67a\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect width=\"32\" height=\"32\" fill=\"#00b67a\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n          '<svg class=\"ps-cart-rating__star\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><defs><linearGradient id=\"ps-cart-half\"><stop offset=\"0%\" stop-color=\"#00b67a\"/><stop offset=\"50%\" stop-color=\"#00b67a\"/><stop offset=\"50%\" stop-color=\"#ddd\"/><stop offset=\"100%\" stop-color=\"#ddd\"/></linearGradient></defs><rect width=\"32\" height=\"32\" fill=\"url(#ps-cart-half)\"/><path d=\"M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z\" fill=\"#fff\"/></svg>' +\n        '</div>' +\n        '<p class=\"ps-cart-rating__text\">Validé par plus <strong>{{ rating_count }} clients</strong></p>' +\n      '</div>';\n\n    function inject() {\n      /* Cible : .free-shipping-bar (zone \"Votre livraison est gratuite\")\n         dans <cart-drawer>. Le badge sera inséré juste AVANT. */\n      var target = document.querySelector('cart-drawer .free-shipping-bar');\n      if (!target) return;\n      /* Évite double injection */\n      if (target.parentElement.querySelector('[data-ps-cart-rating]')) return;\n      /* Crée le badge depuis le HTML string */\n      var wrapper = document.createElement('div');\n      wrapper.innerHTML = BADGE_HTML;\n      var badge = wrapper.firstElementChild;\n      /* Insère AVANT la free-shipping-bar (donc tout en haut du drawer) */\n      target.parentElement.insertBefore(badge, target);\n    }\n\n    /* Zéro le padding du wrapper .section.section--padding créé par Shopify\n       autour de cette Custom Liquid section — sinon le thème applique\n       72px top + 72px bottom = 144px de vide en bas de page. */\n    function killSectionPadding() {\n      /* document.currentScript pointe vers ce <script> au moment de l'exec */\n      var scripts = document.querySelectorAll('script');\n      var ourScript = null;\n      for (var i = scripts.length - 1; i >= 0; i--) {\n        if (scripts[i].textContent && scripts[i].textContent.indexOf('data-ps-cart-rating') > -1) {\n          ourScript = scripts[i];\n          break;\n        }\n      }\n      if (!ourScript) return;\n      var wrapper = ourScript.closest('.section.section--padding');\n      if (wrapper) {\n        wrapper.style.paddingTop = '0';\n        wrapper.style.paddingBottom = '0';\n      }\n    }\n\n    function setup() {\n      killSectionPadding();\n      inject();\n      /* Surveille le cart-drawer pour re-injecter à chaque update\n         (Shopify re-render le contenu après add/remove item) */\n      var drawer = document.querySelector('cart-drawer');\n      if (drawer && window.MutationObserver) {\n        var obs = new MutationObserver(function() {\n          /* petit délai pour laisser le DOM se stabiliser */\n          setTimeout(inject, 50);\n        });\n        obs.observe(drawer, { childList: true, subtree: true });\n      }\n      /* Écoute aussi les events Shopify standards */\n      document.addEventListener('cart:open', inject);\n      document.addEventListener('cart:refresh', inject);\n      document.addEventListener('cart:update', inject);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', setup);\n    } else {\n      setup();\n    }\n  })();\n</script>",
