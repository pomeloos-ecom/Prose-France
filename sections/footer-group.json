    "custom_liquid_BwNDhY": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Section \"Trust badges\" (4 colonnes + carousel mobile)\n  ------------------------------------------------------------\n  Reproduit fidèlement la section :\n  - Satisfait ou remboursé (icône retour)\n  - Atelier français (icône cœur)\n  - Livraison gratuite (icône cadeau)\n  - Qualité premium (icône bouclier)\n  ------------------------------------------------------------\n  Comportement responsive :\n  - Desktop ≥ 1024px : grille 4 colonnes\n  - Tablet ≥ 768px   : grille 2 colonnes\n  - Mobile < 768px   : CAROUSEL horizontal avec scroll-snap\n                       + auto-scroll toutes les 3 secondes\n                       + pause sur interaction utilisateur\n                       (reprend après 5s d'inactivité)\n  ============================================================\n{%- endcomment -%}\n\n<style>\n  .ps-trust {\n    background-color: #F9F4F1;\n    padding: 60px 48px;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    color: #171717;\n  }\n  .ps-trust__viewport {\n    max-width: 1416px;\n    margin: 0 auto;\n  }\n  .ps-trust__track {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 32px;\n  }\n  .ps-trust__card {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    text-align: left;\n  }\n  .ps-trust__icon {\n    flex: 0 0 auto;\n    width: 32px;\n    height: 32px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #171717;\n  }\n  .ps-trust__icon svg { width: 28px; height: 28px; }\n  .ps-trust__text { flex: 1 1 auto; min-width: 0; }\n  .ps-trust__title {\n    display: block;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.2;\n    color: #171717;\n    text-transform: uppercase;\n    letter-spacing: 0.01em;\n    margin: 0 0 6px;\n  }\n  .ps-trust__subtitle {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 400;\n    line-height: 1.5;\n    color: #171717;\n    margin: 0;\n    opacity: 0.85;\n  }\n  .ps-trust__dots { display: none; }\n\n  /* ---------- Tablet ≥ 768px : 2 colonnes ---------- */\n  @media (min-width: 768px) and (max-width: 1023px) {\n    .ps-trust__track {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 28px 32px;\n    }\n  }\n\n  /* ---------- Mobile < 768px : CAROUSEL ---------- */\n  @media (max-width: 767px) {\n    .ps-trust { padding: 40px 0; }\n\n    .ps-trust__viewport {\n      overflow-x: auto;\n      overflow-y: hidden;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n      -ms-overflow-style: none;\n    }\n    .ps-trust__viewport::-webkit-scrollbar { display: none; }\n\n    .ps-trust__track {\n      display: flex;\n      gap: 0;\n      grid-template-columns: none;\n    }\n    .ps-trust__card {\n      flex: 0 0 100%;\n      scroll-snap-align: center;\n      scroll-snap-stop: always;\n      padding: 0 20px;\n      justify-content: center;\n      box-sizing: border-box;\n    }\n    .ps-trust__text { flex: 0 1 auto; }\n    .ps-trust__title { font-size: 16px; }\n    .ps-trust__subtitle { font-size: 12.5px; }\n\n    /* Indicateurs (dots) */\n    .ps-trust__dots {\n      display: flex;\n      justify-content: center;\n      gap: 8px;\n      margin-top: 24px;\n    }\n    .ps-trust__dot {\n      width: 7px;\n      height: 7px;\n      border-radius: 50%;\n      background-color: rgba(23, 23, 23, 0.25);\n      transition: background-color 0.3s ease, transform 0.3s ease;\n    }\n    .ps-trust__dot.is-active {\n      background-color: #171717;\n      transform: scale(1.15);\n    }\n  }\n</style>\n\n<section class=\"ps-trust\" data-ps-trust>\n  <div class=\"ps-trust__viewport\" data-ps-trust-viewport>\n    <div class=\"ps-trust__track\">\n\n      {%- comment -%} === 1. SATISFAIT OU REMBOURSÉ === {%- endcomment -%}\n      <div class=\"ps-trust__card\">\n        <span class=\"ps-trust__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M21.74 5.42C21.74 6.34 20.99 7.09 20.07 7.09H3.42C2.5 7.09 1.75 6.34 1.75 5.42C1.75 4.5 2.5 3.75 3.42 3.75H20.07C20.99 3.75 21.74 4.5 21.74 5.42ZM9.12 15.49L13.49 21.18L14.03 18.71C17.53 19.48 20.52 18.65 21.75 13.05C19.62 15.01 17.81 14.78 15.03 14.17L15.57 11.7L9.13 15.49H9.12Z\" fill=\"currentColor\" stroke=\"none\" opacity=\"0.12\"></path>\n            <path d=\"M9.61 21.07H5.53C4.55 21.07 3.75 20.27 3.75 19.29V7.07999M19.74 7.07999V10.63M11.74 3.87999V6.72999M21.74 5.40999C21.74 6.32999 20.99 7.07999 20.07 7.07999H3.42C2.5 7.07999 1.75 6.32999 1.75 5.40999C1.75 4.48999 2.5 3.73999 3.42 3.73999H20.07C20.99 3.73999 21.74 4.48999 21.74 5.40999ZM9.12 15.5L13.49 21.19L14.03 18.72C17.53 19.49 20.52 18.66 21.75 13.06C19.62 15.02 17.81 14.79 15.03 14.18L15.57 11.71L9.13 15.5H9.12Z\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </span>\n        <div class=\"ps-trust__text\">\n          <strong class=\"ps-trust__title\">Satisfait ou remboursé</strong>\n          <p class=\"ps-trust__subtitle\">30 jours pour changer d'avis</p>\n        </div>\n      </div>\n\n      {%- comment -%} === 2. ATELIER FRANÇAIS === {%- endcomment -%}\n      <div class=\"ps-trust__card\">\n        <span class=\"ps-trust__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M3.16113 4.46875C5.58508 2.0448 9.44716 1.9355 12.0008 4.14085C14.5528 1.9355 18.4149 2.0448 20.8388 4.46875C23.2584 6.88836 23.3716 10.741 21.1785 13.2947L13.4142 21.0858C12.6686 21.8313 11.4809 21.8652 10.6952 21.1874L10.5858 21.0858L2.82141 13.2947C0.628282 10.741 0.741522 6.88836 3.16113 4.46875ZM4.57534 5.88296C2.86819 7.59011 2.81942 10.3276 4.42902 12.0937L4.57534 12.2469L12 19.6715L19.4246 12.2469C21.1819 10.4896 21.1819 7.64032 19.4246 5.88296C17.7174 4.17581 14.9799 4.12704 13.2139 5.73663L13.0606 5.88296L8.81856 10.1249C8.42803 10.5155 8.42803 11.1486 8.81856 11.5391C9.20908 11.9297 9.84225 11.9297 10.2328 11.5391L13.7677 8.00427L17.3026 11.5391C17.6932 11.9297 17.6932 12.5629 17.3026 12.9534C16.912 13.344 16.2789 13.344 15.8884 12.9534L13.7677 10.8327L12 12.6004C10.4378 14.1626 7.9051 14.1626 6.34301 12.6004C4.85291 11.1103 4.78316 8.74049 6.13374 7.16762L6.28438 6.99988L4.57534 5.88296Z\"></path>\n          </svg>\n        </span>\n        <div class=\"ps-trust__text\">\n          <strong class=\"ps-trust__title\">Atelier français</strong>\n          <p class=\"ps-trust__subtitle\">Un service rapide et fiable - à vos côtés</p>\n        </div>\n      </div>\n\n      {%- comment -%} === 3. LIVRAISON GRATUITE === {%- endcomment -%}\n      <div class=\"ps-trust__card\">\n        <span class=\"ps-trust__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M4 11H20V17.2C20 18.8802 20 19.7202 19.673 20.362C19.3854 20.9265 18.9265 21.3854 18.362 21.673C17.7202 22 16.8802 22 15.2 22H8.8C7.11984 22 6.27976 22 5.63803 21.673C5.07354 21.3854 4.6146 20.9265 4.32698 20.362C4 19.7202 4 18.8802 4 17.2V11Z\" fill=\"currentColor\" stroke=\"none\" opacity=\"0.12\"></path>\n            <path d=\"M20 11V17.2C20 18.8802 20 19.7202 19.673 20.362C19.3854 20.9265 18.9265 21.3854 18.362 21.673C17.7202 22 16.8802 22 15.2 22H8.8C7.11984 22 6.27976 22 5.63803 21.673C5.07354 21.3854 4.6146 20.9265 4.32698 20.362C4 19.7202 4 18.8802 4 17.2V11M12 7V22M12 7H15.5C16.8807 7 18 5.88071 18 4.5C18 3.11929 16.8807 2 15.5 2H15.4198C14.2803 2 13.2758 2.74741 12.9484 3.83881L12 7ZM12 7H8.5C7.11929 7 6 5.88071 6 4.5C6 3.11929 7.11929 2 8.5 2H8.58023C9.71968 2 10.7242 2.74741 11.0516 3.83881L12 7ZM4 11H20C21.1046 11 22 10.1046 22 9C22 7.89543 21.1046 7 20 7H4C2.89543 7 2 7.89543 2 9C2 10.1046 2.89543 11 4 11Z\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </span>\n        <div class=\"ps-trust__text\">\n          <strong class=\"ps-trust__title\">Livraison gratuite</strong>\n          <p class=\"ps-trust__subtitle\">En France Métropolitaine</p>\n        </div>\n      </div>\n\n      {%- comment -%} === 4. QUALITÉ PREMIUM === {%- endcomment -%}\n      <div class=\"ps-trust__card\">\n        <span class=\"ps-trust__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" stroke=\"currentColor\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M3 8.11938C3 6.99027 3 6.42571 3.17756 5.93283C3.33451 5.49716 3.59019 5.10373 3.92457 4.78337C4.30286 4.42093 4.81875 4.19165 5.85055 3.73308L9.40073 2.15523C10.3579 1.72982 10.8365 1.51712 11.334 1.43311C11.7749 1.35866 12.2251 1.35866 12.666 1.43311C13.1635 1.51712 13.6421 1.72982 14.5993 2.15523L18.1495 3.73308C19.1812 4.19165 19.6971 4.42093 20.0754 4.78337C20.4098 5.10373 20.6655 5.49716 20.8224 5.93283C21 6.42571 21 6.99027 21 8.11938V13.5748C21 14.8271 21 15.4532 20.8274 16.0216C20.6746 16.5247 20.4241 16.9928 20.0902 17.3991C19.713 17.858 19.192 18.2053 18.1501 18.8999L14.6626 21.2249C13.7003 21.8665 13.2192 22.1872 12.6991 22.3118C12.2395 22.422 11.7605 22.422 11.3009 22.3118C10.7808 22.1872 10.2997 21.8665 9.33744 21.2249L5.84992 18.8999C4.80796 18.2053 4.28697 17.858 3.90982 17.3991C3.57592 16.9928 3.32541 16.5247 3.1726 16.0216C3 15.4532 3 14.8271 3 13.5748V8.11938Z\" fill=\"currentColor\" stroke=\"none\" opacity=\"0.12\"></path>\n            <path d=\"M9 12L11 14L15.5 9.5\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            <path d=\"M3 8.12V13.57C3 14.83 3 15.45 3.17 16.02C3.33 16.52 3.58 16.99 3.91 17.4C4.29 17.86 4.81 18.21 5.85 18.9L9.34 21.22C10.3 21.87 10.78 22.19 11.3 22.31C11.76 22.42 12.24 22.42 12.7 22.31C13.22 22.19 13.7 21.87 14.66 21.22L18.15 18.9C19.19 18.21 19.71 17.86 20.09 17.4C20.42 16.99 20.67 16.52 20.83 16.02C21 15.45 21 14.83 21 13.57V8.12C21 6.99 21 6.43 20.82 5.93C20.67 5.5 20.41 5.1 20.08 4.78C19.7 4.42 19.18 4.19 18.15 3.73L14.6 2.16C13.64 1.73 13.16 1.52 12.67 1.43C12.23 1.36 11.78 1.36 11.33 1.43C10.84 1.52 10.36 1.73 9.4 2.16L5.85 3.73C4.82 4.19 4.3 4.42 3.92 4.78C3.59 5.1 3.33 5.5 3.18 5.93C3 6.43 3 6.99 3 8.12Z\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </span>\n        <div class=\"ps-trust__text\">\n          <strong class=\"ps-trust__title\">Qualité premium</strong>\n          <p class=\"ps-trust__subtitle\">Des normes sans compromis pour chaque pièce</p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  {%- comment -%} Indicateurs (visibles seulement sur mobile via CSS) {%- endcomment -%}\n  <div class=\"ps-trust__dots\" data-ps-trust-dots>\n    <span class=\"ps-trust__dot is-active\" data-i=\"0\"></span>\n    <span class=\"ps-trust__dot\" data-i=\"1\"></span>\n    <span class=\"ps-trust__dot\" data-i=\"2\"></span>\n    <span class=\"ps-trust__dot\" data-i=\"3\"></span>\n  </div>\n</section>\n\n<script>\n  (function() {\n    'use strict';\n    var root = document.querySelector('[data-ps-trust]');\n    if (!root) return;\n    var viewport = root.querySelector('[data-ps-trust-viewport]');\n    var dotsWrap = root.querySelector('[data-ps-trust-dots]');\n    var cards = viewport ? viewport.querySelectorAll('.ps-trust__card') : [];\n    if (!viewport || cards.length === 0) return;\n\n    var dots = dotsWrap ? dotsWrap.querySelectorAll('.ps-trust__dot') : [];\n    var index = 0;\n    var timer = null;\n    var resumeTimer = null;\n    var INTERVAL = 3000; // 3 secondes\n    var RESUME_DELAY = 5000; // reprise auto-scroll 5s après interaction\n\n    function isMobile() {\n      return window.matchMedia('(max-width: 767px)').matches;\n    }\n\n    function setActiveDot(i) {\n      if (!dots.length) return;\n      dots.forEach(function(d, di) {\n        d.classList.toggle('is-active', di === i);\n      });\n    }\n\n    function goTo(i) {\n      index = (i + cards.length) % cards.length;\n      var card = cards[index];\n      if (!card) return;\n      viewport.scrollTo({\n        left: card.offsetLeft - viewport.offsetLeft,\n        behavior: 'smooth'\n      });\n      setActiveDot(index);\n    }\n\n    function next() {\n      goTo(index + 1);\n    }\n\n    function start() {\n      if (!isMobile()) return;\n      stop();\n      timer = setInterval(next, INTERVAL);\n    }\n    function stop() {\n      if (timer) { clearInterval(timer); timer = null; }\n    }\n    function pauseThenResume() {\n      stop();\n      if (resumeTimer) clearTimeout(resumeTimer);\n      resumeTimer = setTimeout(start, RESUME_DELAY);\n    }\n\n    // Update active dot on manual scroll\n    var scrollDebounce;\n    viewport.addEventListener('scroll', function() {\n      clearTimeout(scrollDebounce);\n      scrollDebounce = setTimeout(function() {\n        var w = viewport.offsetWidth;\n        if (w === 0) return;\n        var i = Math.round(viewport.scrollLeft / w);\n        if (i !== index) {\n          index = i;\n          setActiveDot(index);\n        }\n      }, 80);\n    }, { passive: true });\n\n    // Pause sur interaction\n    ['touchstart', 'mousedown', 'pointerdown'].forEach(function(ev) {\n      viewport.addEventListener(ev, pauseThenResume, { passive: true });\n    });\n\n    // Dots cliquables\n    dots.forEach(function(d) {\n      d.addEventListener('click', function() {\n        var i = parseInt(d.getAttribute('data-i'), 10);\n        if (!isNaN(i)) {\n          goTo(i);\n          pauseThenResume();\n        }\n      });\n    });\n\n    // Stop si onglet caché (économie batterie / requestAnimationFrame friendly)\n    document.addEventListener('visibilitychange', function() {\n      if (document.hidden) stop(); else start();\n    });\n\n    // Redémarrer sur resize (passe de desktop à mobile et vice-versa)\n    var resizeDebounce;\n    window.addEventListener('resize', function() {\n      clearTimeout(resizeDebounce);\n      resizeDebounce = setTimeout(function() {\n        if (isMobile()) start(); else stop();\n      }, 200);\n    });\n\n    start();\n  })();\n</script>",
