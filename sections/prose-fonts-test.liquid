<style>
.pft { background: #f5f0eb; min-height: 100vh; padding: 60px 24px 100px; }
.pft-title {
  text-align: center; margin-bottom: 64px;
  font-family: 'Inter', sans-serif; color: #0a0a0a;
}
.pft-title h1 { font-size: 28px; font-weight: 600; letter-spacing: -.02em; margin-bottom: 8px; }
.pft-title p  { font-size: 14px; color: #777; }

.pft-grid {
  display: grid; grid-template-columns: 1fr; gap: 2px;
  max-width: 1200px; margin: 0 auto;
}
@media(min-width:900px) { .pft-grid { grid-template-columns: 1fr 1fr; } }

/* Card */
.fc {
  background: #fff; padding: 44px 40px; position: relative;
  border: 1px solid #e8e2da;
  transition: box-shadow .2s;
}
.fc:hover { box-shadow: 0 8px 40px rgba(0,0,0,.07); z-index: 1; }

.fc-num {
  position: absolute; top: 18px; right: 22px;
  font-family: 'Inter', sans-serif; font-size: 11px;
  font-weight: 600; color: #bbb; letter-spacing: .06em;
}
.fc-tag {
  display: inline-flex; align-items: center; gap: 6px;
  background: #f5f0eb; border: 1px solid #e8e2da;
  padding: 5px 12px; border-radius: 2px;
  font-family: 'Inter', sans-serif;
  font-size: 10px; font-weight: 600; color: #c9a96e;
  letter-spacing: .1em; text-transform: uppercase;
  margin-bottom: 28px;
}
.fc-eyebrow {
  font-size: 10px; font-weight: 700; letter-spacing: .18em;
  text-transform: uppercase; color: #c9a96e; margin-bottom: 12px;
  font-family: 'Inter', sans-serif;
}
.fc-divider {
  width: 40px; height: 1px; background: #c9a96e; margin: 20px 0;
}
.fc-meta {
  margin-top: 32px; padding-top: 20px; border-top: 1px solid #ede7de;
  display: flex; gap: 16px; flex-wrap: wrap;
  font-family: 'Inter', sans-serif; font-size: 11px; color: #aaa;
}
.fc-meta strong { color: #555; font-weight: 600; }

/* ── Combo 1 — Playfair Display + Lato ── */
.fc1 .fc-h { font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; line-height: 1.1; letter-spacing: -.01em; color: #0a0a0a; }
.fc1 .fc-h em { font-style: italic; color: #c9a96e; }
.fc1 .fc-sub { font-family: 'Source Sans 3', sans-serif; font-size: 17px; font-weight: 300; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc1 .fc-body { font-family: 'Source Sans 3', sans-serif; font-size: 14px; color: #555; line-height: 1.75; }

/* ── Combo 2 — Cormorant Garamond + Jost ── */
.fc2 .fc-h { font-family: 'Cormorant Garamond', serif; font-size: 44px; font-weight: 600; line-height: 1.08; letter-spacing: -.01em; color: #0a0a0a; }
.fc2 .fc-h em { font-style: italic; color: #c9a96e; }
.fc2 .fc-sub { font-family: 'Jost', sans-serif; font-size: 14px; font-weight: 300; letter-spacing: .08em; text-transform: uppercase; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc2 .fc-body { font-family: 'Jost', sans-serif; font-size: 14px; font-weight: 300; color: #555; line-height: 1.75; }

/* ── Combo 3 — Libre Baskerville + Source Sans 3 ── */
.fc3 .fc-h { font-family: 'Libre Baskerville', serif; font-size: 34px; font-weight: 700; line-height: 1.15; color: #0a0a0a; }
.fc3 .fc-h em { font-style: italic; color: #c9a96e; }
.fc3 .fc-sub { font-family: 'Source Sans 3', sans-serif; font-size: 16px; font-weight: 400; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc3 .fc-body { font-family: 'Source Sans 3', sans-serif; font-size: 14px; color: #555; line-height: 1.75; }

/* ── Combo 4 — Bodoni Moda + DM Sans ── */
.fc4 .fc-h { font-family: 'Bodoni Moda', serif; font-size: 40px; font-weight: 700; line-height: 1.1; letter-spacing: -.02em; color: #0a0a0a; }
.fc4 .fc-h em { font-style: italic; color: #c9a96e; }
.fc4 .fc-sub { font-family: 'DM Sans', sans-serif; font-size: 15px; font-weight: 300; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc4 .fc-body { font-family: 'DM Sans', sans-serif; font-size: 14px; color: #555; line-height: 1.75; }

/* ── Combo 5 — DM Serif Display + Inter ── */
.fc5 .fc-h { font-family: 'DM Serif Display', serif; font-size: 42px; font-weight: 400; line-height: 1.1; color: #0a0a0a; }
.fc5 .fc-h em { font-style: italic; color: #c9a96e; }
.fc5 .fc-sub { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: #6b6b6b; line-height: 1.65; margin-top: 14px; letter-spacing: .01em; }
.fc5 .fc-body { font-family: 'Inter', sans-serif; font-size: 13px; color: #555; line-height: 1.8; }

/* ── Combo 6 — Fraunces + Figtree ── */
.fc6 .fc-h { font-family: 'Fraunces', serif; font-size: 42px; font-weight: 700; line-height: 1.1; letter-spacing: -.02em; color: #0a0a0a; }
.fc6 .fc-h em { font-style: italic; font-weight: 300; color: #c9a96e; }
.fc6 .fc-sub { font-family: 'Figtree', sans-serif; font-size: 15px; font-weight: 300; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc6 .fc-body { font-family: 'Figtree', sans-serif; font-size: 14px; color: #555; line-height: 1.75; }

/* ── Combo 7 — Marcellus + Raleway ── */
.fc7 .fc-h { font-family: 'Marcellus', serif; font-size: 40px; font-weight: 400; line-height: 1.12; color: #0a0a0a; }
.fc7 .fc-h em { font-style: normal; color: #c9a96e; }
.fc7 .fc-sub { font-family: 'Raleway', sans-serif; font-size: 13px; font-weight: 400; letter-spacing: .12em; text-transform: uppercase; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc7 .fc-body { font-family: 'Raleway', sans-serif; font-size: 14px; font-weight: 300; color: #555; line-height: 1.75; }

/* ── Combo 8 — Cinzel + Montserrat ── */
.fc8 .fc-h { font-family: 'Cinzel', serif; font-size: 32px; font-weight: 600; line-height: 1.2; letter-spacing: .04em; text-transform: uppercase; color: #0a0a0a; }
.fc8 .fc-h em { font-style: normal; color: #c9a96e; }
.fc8 .fc-sub { font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 400; letter-spacing: .14em; text-transform: uppercase; color: #6b6b6b; line-height: 1.65; margin-top: 14px; }
.fc8 .fc-body { font-family: 'Montserrat', sans-serif; font-size: 13px; font-weight: 300; color: #555; line-height: 1.8; }
</style>

