{%- capture ico_custom -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93 17.66 6.34M6.34 17.66l-1.41 1.41M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>{%- endcapture -%}
{%- capture ico_guarantee -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}
{%- capture ico_shipping -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10"/><path d="M2 12h20M12 2c-4 4-4 16 0 20M12 2c4 4 4 16 0 20"/></svg>{%- endcapture -%}

{%- assign card_eyebrows = 'Savoir-faire certifié,100% sur mesure,Garantie 2 ans,Livraison mondiale' | split: ',' -%}
<div class="pwc">
  <div class="pwc-wrap">

    <div class="pwc-head">
      <span class="pwc-eyebrow reveal">Pourquoi Prose</span>
      <h2 class="pwc-title reveal" style="transition-delay:.08s">La différence qui change tout</h2>
      <p class="pwc-sub reveal" style="transition-delay:.16s">Quatre engagements qui font de Prose une marque horlogère à part entière.</p>
    </div>

    <div class="pwc-grid">

      <!-- Card 1 — Savoir-faire -->
      <div class="pwc-card reveal">
        <div class="pwc-img">
          {%- if section.settings.card_1_image != blank -%}
            <img src="{{ section.settings.card_1_image | image_url: width: 800 }}" alt="Savoir-faire" loading="lazy">
          {%- else -%}
            <div class="pwc-img-ph">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke-linecap="round"/></svg>
              <span>Photo 1 — Portrait<br><small style="opacity:.7">Image placeholder</small></span>
            </div>
          {%- endif -%}
        </div>
        <div class="pwc-overlay"></div>
        <div class="pwc-corners">
          <div class="pwc-corner pwc-corner-tl">{{ ico_craft }}</div>
          <div class="pwc-corner pwc-corner-tr">{{ ico_craft }}</div>
          <div class="pwc-corner pwc-corner-bl">{{ ico_craft }}</div>
          <div class="pwc-corner pwc-corner-br">{{ ico_craft }}</div>
        </div>
        <div class="pwc-body">
          <h3>L'art de l'horloger français</h3>
          <p>Nos horlogers certifiés maîtrisent les techniques traditionnelles et modernes pour créer des pièces d'exception qui traversent le temps.</p>
        </div>
      </div>

      <!-- Card 2 — Sur mesure -->
      <div class="pwc-card reveal" style="transition-delay:.1s;">
        <div class="pwc-img">
          {%- if section.settings.card_2_image != blank -%}
            <img src="{{ section.settings.card_2_image | image_url: width: 600 }}" alt="Sur mesure" loading="lazy">
          {%- else -%}
            <div class="pwc-img-ph">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke-linecap="round"/></svg>
              <span>Photo 2<br><small style="opacity:.7">Image placeholder</small></span>
            </div>
          {%- endif -%}
        </div>
        <div class="pwc-overlay"></div>
        <div class="pwc-corners">
          <div class="pwc-corner pwc-corner-tl">{{ ico_custom }}</div>
          <div class="pwc-corner pwc-corner-tr">{{ ico_custom }}</div>
          <div class="pwc-corner pwc-corner-bl">{{ ico_custom }}</div>
          <div class="pwc-corner pwc-corner-br">{{ ico_custom }}</div>
        </div>
        <div class="pwc-body">
          <h3>Chaque détail vous ressemble</h3>
          <p>Cadran, bracelet, boîtier, gravure — chaque composant est choisi selon votre vision et votre personnalité.</p>
        </div>
      </div>

      <!-- Card 3 — Garantie -->
      <div class="pwc-card reveal" style="transition-delay:.2s;">
        <div class="pwc-img">
          {%- if section.settings.card_3_image != blank -%}
            <img src="{{ section.settings.card_3_image | image_url: width: 600 }}" alt="Garantie" loading="lazy">
          {%- else -%}
            <div class="pwc-img-ph">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke-linecap="round"/></svg>
              <span>Photo 3<br><small style="opacity:.7">Image placeholder</small></span>
            </div>
          {%- endif -%}
        </div>
        <div class="pwc-overlay"></div>
        <div class="pwc-corners">
          <div class="pwc-corner pwc-corner-tl">{{ ico_guarantee }}</div>
          <div class="pwc-corner pwc-corner-tr">{{ ico_guarantee }}</div>
          <div class="pwc-corner pwc-corner-bl">{{ ico_guarantee }}</div>
          <div class="pwc-corner pwc-corner-br">{{ ico_guarantee }}</div>
        </div>
        <div class="pwc-body">
          <h3>Zéro risque. Tout bénéfice.</h3>
          <p>Chaque création Prose est garantie 2 ans avec un service après-vente dédié. Nous répondons toujours présent.</p>
        </div>
      </div>

      <!-- Card 4 — Livraison (large) -->
      <div class="pwc-card reveal" style="transition-delay:.3s;">
        <div class="pwc-img">
          {%- if section.settings.card_4_image != blank -%}
            <img src="{{ section.settings.card_4_image | image_url: width: 1000 }}" alt="Livraison" loading="lazy">
          {%- else -%}
            <div class="pwc-img-ph">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke-linecap="round"/></svg>
              <span>Photo 4 — Paysage<br><small style="opacity:.7">Image placeholder</small></span>
            </div>
          {%- endif -%}
        </div>
        <div class="pwc-overlay"></div>
        <div class="pwc-corners">
          <div class="pwc-corner pwc-corner-tl">{{ ico_shipping }}</div>
          <div class="pwc-corner pwc-corner-tr">{{ ico_shipping }}</div>
          <div class="pwc-corner pwc-corner-bl">{{ ico_shipping }}</div>
          <div class="pwc-corner pwc-corner-br">{{ ico_shipping }}</div>
        </div>
        <div class="pwc-body">
          <h3>Jusqu'à votre porte, partout</h3>
          <p>Votre pièce unique est livrée dans un écrin de luxe premium, assurée et tracée en temps réel partout dans le monde.</p>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function(){
  if (!window.IntersectionObserver) {
    document.querySelectorAll('.pwc .reveal').forEach(function(el){ el.classList.add('visible'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.pwc .reveal').forEach(function(el){ io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Why Choose Bento",
  "tag": "div",
  "settings": [
    { "type": "header",       "content": "Images des cartes" },
    { "type": "image_picker", "id": "card_1_image", "label": "Carte 1 — Savoir-faire (portrait recommandé)" },
    { "type": "image_picker", "id": "card_2_image", "label": "Carte 2 — Sur mesure" },
    { "type": "image_picker", "id": "card_3_image", "label": "Carte 3 — Garantie" },
    { "type": "image_picker", "id": "card_4_image", "label": "Carte 4 — Livraison (paysage recommandé)" }
  ],
  "presets": [{ "name": "Prose Why Choose Bento" }]
}
{% endschema %}
