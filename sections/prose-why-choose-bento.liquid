{% comment %}
  Prose — Why Choose Us (Bento Grid)
  Inspired by: 21st.dev — Ruixen Bento Cards + FUI Bento Grid
  4 cards asymétriques avec coins +, image en fond, scroll reveal
{% endcomment %}

<style>
.pwc *, .pwc *::before, .pwc *::after { box-sizing: border-box; margin: 0; padding: 0; }

.pwc {
  background: var(--color-background, #fff);
  padding: 80px 24px;
  font-family: var(--font-body-family, sans-serif);
}
@media(min-width:768px) { .pwc { padding: 100px 48px; } }
@media(min-width:1200px) { .pwc { padding: 120px 80px; } }

.pwc-wrap { max-width: 1200px; margin: 0 auto; }

/* ── Header ───────────────────────────── */
.pwc-head { margin-bottom: 52px; }
.pwc-eyebrow {
  display: inline-block; font-size: 11px; font-weight: 700;
  letter-spacing: .18em; text-transform: uppercase; color: #c9a96e; margin-bottom: 14px;
}
.pwc-title {
  font-family: var(--font-heading-family, Georgia, serif);
  font-size: clamp(28px,4vw,48px); font-weight: 700;
  letter-spacing: -.02em; line-height: 1.1; color: #0a0a0a;
  margin-bottom: 14px;
}
.pwc-sub { font-size: 16px; color: #6b6b6b; max-width: 520px; line-height: 1.65; }

/* ── Bento Grid ───────────────────────── */
.pwc-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
@media(min-width:640px) {
  .pwc-grid { grid-template-columns: 1fr 1fr; }
}
@media(min-width:1024px) {
  .pwc-grid {
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: auto auto;
  }
  .pwc-card:nth-child(1) { grid-row: span 2; }
  .pwc-card:nth-child(4) { grid-column: span 2; }
}

/* ── Card base ────────────────────────── */
.pwc-card {
  position: relative;
  border: 1px dashed #c5bdb5;
  border-radius: 12px;
  overflow: hidden;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: #f8f4ef;
  transition: border-color .3s, box-shadow .3s, transform .3s;
  cursor: default;
}
.pwc-card:hover {
  border-color: #c9a96e;
  box-shadow: 0 20px 60px rgba(0,0,0,.08);
  transform: translateY(-4px);
}

/* tall card on desktop */
@media(min-width:1024px) {
  .pwc-card:nth-child(1) { min-height: 520px; }
  .pwc-card:nth-child(4) { min-height: 220px; }
}

/* ── Card image (fond) ────────────────── */
.pwc-img {
  position: absolute; inset: 0;
  z-index: 0;
}
.pwc-img img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .5s ease;
}
.pwc-card:hover .pwc-img img { transform: scale(1.04); }

/* placeholder */
.pwc-img-ph {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #ede7de, #ddd5c8);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 10px; color: #a09585; font-size: 11px; text-align: center;
}
.pwc-img-ph svg { width: 28px; height: 28px; opacity: .4; }

/* gradient overlay */
.pwc-overlay {
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(to top, rgba(10,10,10,.78) 0%, rgba(10,10,10,.1) 60%, transparent 100%);
  transition: opacity .3s;
}
.pwc-card:hover .pwc-overlay { opacity: .85; }

/* ── Card content ─────────────────────── */
.pwc-body {
  position: relative; z-index: 2;
  padding: 28px 24px;
}
.pwc-card-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: 700; letter-spacing: .16em;
  text-transform: uppercase; color: #c9a96e; margin-bottom: 10px;
}
.pwc-card-ico {
  width: 28px; height: 28px; border-radius: 6px;
  background: rgba(201,169,110,.15);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.pwc-card-ico svg { width: 14px; height: 14px; color: #c9a96e; }
.pwc-card h3 {
  font-family: var(--font-heading-family, Georgia, serif);
  font-size: 20px; font-weight: 700; color: #fff;
  letter-spacing: -.01em; margin-bottom: 8px; line-height: 1.2;
}
.pwc-card p { font-size: 13px; color: rgba(255,255,255,.65); line-height: 1.65; }

/* ── Corner + icons (Ruixen style) ─────── */
.pwc-corners { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
.pwc-corner {
  position: absolute; width: 20px; height: 20px;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transition: opacity .3s;
}
.pwc-card:hover .pwc-corner { opacity: 1; }
.pwc-corner svg { width: 18px; height: 18px; color: #c9a96e; }
.pwc-corner-tl { top: -9px;  left: -9px;  }
.pwc-corner-tr { top: -9px;  right: -9px; }
.pwc-corner-bl { bottom: -9px; left: -9px;  }
.pwc-corner-br { bottom: -9px; right: -9px; }

/* ── Scroll reveal ───────────────────── */
.pwc-card.reveal {
  opacity: 0; transform: translateY(28px);
  transition: opacity .6s cubic-bezier(.22,1,.36,1), transform .6s cubic-bezier(.22,1,.36,1),
              border-color .3s, box-shadow .3s;
}
.pwc-card.reveal.visible { opacity: 1; transform: translateY(0); }
.pwc-card.reveal.visible:hover { transform: translateY(-4px); }
.pwc-head .pwc-title.reveal, .pwc-head .pwc-sub.reveal, .pwc-head .pwc-eyebrow.reveal {
  opacity: 0; transform: translateY(20px);
  transition: opacity .6s ease, transform .6s ease;
}
.pwc-head .pwc-title.reveal.visible,
.pwc-head .pwc-sub.reveal.visible,
.pwc-head .pwc-eyebrow.reveal.visible { opacity: 1; transform: none; }
</style>

{%- comment -%} SVG icons helper {%- endcomment -%}
