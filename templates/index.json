    "custom_liquid_FaB7YF": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Section \"Best-sellers\" (2 onglets + carousel)\n  ------------------------------------------------------------\n  Reproduit fidèlement la section actuelle, avec améliorations :\n  - 5 produits visibles sur desktop (au lieu de 4)\n  - Drag-to-scroll souris activé sur ordinateur\n  - Bouton \"Voir toute la collection\" sous chaque carousel\n  - Mobile : comportement inchangé (swipe natif, ~1.5 cards visibles)\n  - 2 flèches rondes outline en haut à droite (style original)\n  ------------------------------------------------------------\n  ⚠️  À ÉDITER en haut du fichier : les 2 handles de collection\n  Si tes handles sont différents de \"nouveautes\" et \"coups-de-coeur\",\n  remplace-les ci-dessous.\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ===== CONFIGURATION ===== {%- endcomment -%}\n{%- assign section_title  = \"Best-sellers\" -%}\n{%- assign tab1_label     = \"Les nouveautés\" -%}\n{%- assign tab1_handle    = \"les-nouveautes\" -%}\n{%- assign tab2_label     = \"Vos coups de cœur\" -%}\n{%- assign tab2_handle    = \"vos-coups-de-coeur\" -%}\n{%- assign products_limit = 12 -%}\n{%- comment -%} ========================== {%- endcomment -%}\n\n<style>\n  .ps-best {\n    background-color: #F9F4F1;\n    padding: 70px 48px;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    color: #171717;\n  }\n  .ps-best__inner { max-width: 1416px; margin: 0 auto; }\n\n  /* ===== Header : titre + onglets + flèches ===== */\n  .ps-best__header {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 24px;\n    margin-bottom: 36px;\n    flex-wrap: wrap;\n  }\n  .ps-best__head-left { flex: 1 1 auto; min-width: 0; }\n  .ps-best__title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(32px, 4.4vw, 56px);\n    line-height: 1;\n    color: #000;\n    margin: 0 0 22px;\n    letter-spacing: -0.01em;\n  }\n  .ps-best__tabs {\n    display: flex;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .ps-best__tab {\n    padding: 12px 22px;\n    border: 0;\n    background-color: transparent;\n    color: #171717;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1;\n    border-radius: 999px;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: background-color 0.2s ease, color 0.2s ease;\n  }\n  .ps-best__tab:hover { background-color: rgba(0,0,0,0.05); }\n  .ps-best__tab.is-active {\n    background-color: #121212;\n    color: #fff;\n  }\n\n  /* ===== Flèches navigation ===== */\n  .ps-best__nav {\n    display: flex;\n    gap: 12px;\n    flex-shrink: 0;\n  }\n  .ps-best__arrow {\n    width: 44px;\n    height: 44px;\n    border-radius: 50%;\n    border: 1.5px solid rgba(0,0,0,0.25);\n    background-color: transparent;\n    color: #171717;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;\n  }\n  .ps-best__arrow:hover {\n    background-color: #121212;\n    border-color: #121212;\n    color: #fff;\n  }\n  .ps-best__arrow:disabled {\n    opacity: 0.3;\n    cursor: not-allowed;\n  }\n  .ps-best__arrow svg { width: 18px; height: 18px; }\n\n  /* ===== Panels (un par onglet) ===== */\n  .ps-best__panel { display: none; }\n  .ps-best__panel.is-active { display: block; }\n\n  /* ===== Track scrollable ===== */\n  .ps-best__viewport {\n    overflow-x: auto;\n    overflow-y: hidden;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n    margin: 0 -8px; /* compenser le padding interne des cards */\n  }\n  .ps-best__viewport::-webkit-scrollbar { display: none; }\n  .ps-best__track {\n    display: flex;\n    gap: 24px;\n    padding: 0 8px 4px;\n    scroll-snap-type: x mandatory;\n    cursor: grab;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-touch-callout: none;\n  }\n  .ps-best__track.is-dragging {\n    cursor: grabbing;\n    scroll-snap-type: none;\n    scroll-behavior: auto;\n  }\n  .ps-best__track.is-dragging * { pointer-events: none !important; }\n\n  /* ===== Card produit ===== */\n  .ps-best__card {\n    flex: 0 0 calc((100% - 24px) / 2);  /* mobile : ~2 cards visibles */\n    scroll-snap-align: start;\n    background-color: #EEE7E0;\n    border-radius: 16px;\n    overflow: hidden;\n    text-decoration: none;\n    color: #171717;\n    display: flex;\n    flex-direction: column;\n    box-sizing: border-box;\n    transition: transform 0.25s ease, box-shadow 0.25s ease;\n    -webkit-user-drag: none;\n  }\n  .ps-best__card:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 10px 24px rgba(0,0,0,0.10);\n  }\n  .ps-best__card-media {\n    position: relative;\n    aspect-ratio: 1 / 1;\n    overflow: hidden;\n  }\n  .ps-best__card-img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .ps-best__sold-badge {\n    position: absolute;\n    left: 50%;\n    bottom: 18px;\n    transform: translateX(-50%);\n    padding: 7px 14px;\n    background-color: rgba(238, 231, 224, 0.9);\n    color: #171717;\n    font-size: 12px;\n    font-weight: 500;\n    border: 1px solid rgba(0,0,0,0.5);\n    border-radius: 2px;\n    letter-spacing: 0.02em;\n    pointer-events: none;\n  }\n  .ps-best__card-info {\n    padding: 18px 22px 22px;\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 10px;\n    flex: 1 1 auto;\n  }\n  .ps-best__card-title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 15px;\n    font-weight: 500;\n    line-height: 1.3;\n    color: #171717;\n    margin: 0;\n    flex: 1 1 auto;\n  }\n  .ps-best__card-prices {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    gap: 2px;\n    flex-shrink: 0;\n    font-size: 14px;\n  }\n  .ps-best__price {\n    font-weight: 500;\n    color: #171717;\n    white-space: nowrap;\n  }\n  .ps-best__price--compare {\n    color: #c0392b;\n    text-decoration: line-through;\n    font-size: 13px;\n  }\n\n  /* ===== Bouton \"Voir toute la collection\" ===== */\n  .ps-best__view-all-wrap {\n    display: flex;\n    justify-content: center;\n    margin-top: 40px;\n  }\n  .ps-best__view-all {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 14px 32px;\n    background-color: transparent;\n    color: #121212;\n    border: 2px solid #121212;\n    border-radius: 0;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    text-decoration: none;\n    cursor: pointer;\n    transition: background-color 0.25s ease, color 0.25s ease;\n  }\n  .ps-best__view-all:hover {\n    background-color: #121212;\n    color: #fff;\n  }\n  .ps-best__view-all svg {\n    width: 14px;\n    height: 14px;\n    transition: transform 0.25s ease;\n  }\n  .ps-best__view-all:hover svg { transform: translateX(4px); }\n\n  /* ===== Tablet ≥ 768px : ~3 cards (gap réduit à 16) ===== */\n  @media (min-width: 768px) {\n    .ps-best__track { gap: 16px; }\n    .ps-best__card {\n      flex: 0 0 calc((100% - 32px) / 3);  /* 3 cards × gap 16 ×2 = 32 */\n    }\n  }\n\n  /* ===== Desktop ≥ 1024px : 5 cards (gap réduit à 12 → cards plus grandes) ===== */\n  @media (min-width: 1024px) {\n    .ps-best { padding: 90px 48px; }\n    .ps-best__title { margin-bottom: 28px; }\n    .ps-best__track { gap: 12px; }\n    .ps-best__card {\n      flex: 0 0 calc((100% - 48px) / 5);  /* 5 cards × gap 12 ×4 = 48 */\n    }\n  }\n\n  /* ===== Mobile (< 768px) ===== */\n  @media (max-width: 767px) {\n    .ps-best { padding: 50px 16px; }\n    .ps-best__header { margin-bottom: 24px; }\n    .ps-best__nav { display: none; } /* pas de flèches sur mobile */\n    .ps-best__tab { padding: 11px 18px; font-size: 13px; }\n    .ps-best__card { flex: 0 0 70%; }\n    .ps-best__card-info { padding: 14px 16px 18px; }\n    .ps-best__card-title { font-size: 14px; }\n    .ps-best__view-all { width: 100%; max-width: 320px; justify-content: center; }\n  }\n</style>\n\n<section class=\"ps-best\" data-ps-best>\n  <div class=\"ps-best__inner\">\n\n    <header class=\"ps-best__header\">\n      <div class=\"ps-best__head-left\">\n        <h2 class=\"ps-best__title\">{{ section_title }}</h2>\n        <div class=\"ps-best__tabs\" role=\"tablist\">\n          <button class=\"ps-best__tab is-active\" data-tab-btn=\"0\" role=\"tab\">{{ tab1_label }}</button>\n          <button class=\"ps-best__tab\" data-tab-btn=\"1\" role=\"tab\">{{ tab2_label }}</button>\n        </div>\n      </div>\n\n      <div class=\"ps-best__nav\">\n        <button class=\"ps-best__arrow\" data-prev aria-label=\"Précédent\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <polyline points=\"15 18 9 12 15 6\"/>\n          </svg>\n        </button>\n        <button class=\"ps-best__arrow\" data-next aria-label=\"Suivant\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <polyline points=\"9 18 15 12 9 6\"/>\n          </svg>\n        </button>\n      </div>\n    </header>\n\n    {%- comment -%} ===== Boucle générique pour les 2 onglets ===== {%- endcomment -%}\n    {%- assign tab_handles = tab1_handle | append: \",\" | append: tab2_handle | split: \",\" -%}\n\n    {%- for handle in tab_handles -%}\n      {%- assign coll = collections[handle] -%}\n      {%- assign idx = forloop.index0 -%}\n      {%- assign panel_class = \"ps-best__panel\" -%}\n      {%- if idx == 0 -%}{%- assign panel_class = panel_class | append: \" is-active\" -%}{%- endif -%}\n\n      <div class=\"{{ panel_class }}\" data-tab-panel=\"{{ idx }}\">\n        <div class=\"ps-best__viewport\" data-viewport>\n          <div class=\"ps-best__track\" data-track>\n            {%- if coll.products.size > 0 -%}\n              {%- for product in coll.products limit: products_limit -%}\n                <a href=\"{{ product.url }}\" class=\"ps-best__card\" draggable=\"false\">\n                  <div class=\"ps-best__card-media\">\n                    {%- if product.featured_image -%}\n                      <img class=\"ps-best__card-img\"\n                           src=\"{{ product.featured_image | image_url: width: 600 }}\"\n                           alt=\"{{ product.title | escape }}\"\n                           loading=\"lazy\"\n                           width=\"600\" height=\"600\"\n                           draggable=\"false\">\n                    {%- endif -%}\n                    {%- unless product.available -%}\n                      <span class=\"ps-best__sold-badge\">Épuisé</span>\n                    {%- endunless -%}\n                  </div>\n                  <div class=\"ps-best__card-info\">\n                    <h3 class=\"ps-best__card-title\">{{ product.title }}</h3>\n                    <div class=\"ps-best__card-prices\">\n                      <span class=\"ps-best__price\">{{ product.price | money }}</span>\n                      {%- if product.compare_at_price > product.price -%}\n                        <span class=\"ps-best__price--compare\">{{ product.compare_at_price | money }}</span>\n                      {%- endif -%}\n                    </div>\n                  </div>\n                </a>\n              {%- endfor -%}\n            {%- else -%}\n              <p style=\"padding: 40px; color: #888;\">⚠️ La collection \"{{ handle }}\" est vide ou n'existe pas. Modifie le handle en haut du fichier.</p>\n            {%- endif -%}\n          </div>\n        </div>\n\n        <div class=\"ps-best__view-all-wrap\">\n          <a href=\"/collections/{{ handle }}\" class=\"ps-best__view-all\">\n            <span>Voir toute la collection</span>\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/>\n              <polyline points=\"12 5 19 12 12 19\"/>\n            </svg>\n          </a>\n        </div>\n      </div>\n    {%- endfor -%}\n\n  </div>\n</section>\n\n<script>\n  (function() {\n    'use strict';\n\n    function isDesktop() {\n      return window.matchMedia('(min-width: 1024px)').matches;\n    }\n\n    function setupSection(root) {\n      if (!root || root.__psBestInit) return;\n      root.__psBestInit = true;\n\n      var tabs    = root.querySelectorAll('[data-tab-btn]');\n      var panels  = root.querySelectorAll('[data-tab-panel]');\n      var prevBtn = root.querySelector('[data-prev]');\n      var nextBtn = root.querySelector('[data-next]');\n\n      function activeTrack() {\n        var p = root.querySelector('[data-tab-panel].is-active') ||\n                root.querySelector('[data-tab-panel]');\n        return p ? p.querySelector('[data-track]') : null;\n      }\n\n      function setActiveTab(i) {\n        for (var bi = 0; bi < tabs.length; bi++) {\n          tabs[bi].classList.toggle('is-active', bi === i);\n        }\n        for (var pi = 0; pi < panels.length; pi++) {\n          panels[pi].classList.toggle('is-active', pi === i);\n        }\n        var t = activeTrack();\n        if (t) t.scrollTo({ left: 0, behavior: 'smooth' });\n      }\n\n      for (var ti = 0; ti < tabs.length; ti++) {\n        (function(idx) {\n          tabs[idx].addEventListener('click', function(e) {\n            e.preventDefault();\n            setActiveTab(idx);\n          });\n        })(ti);\n      }\n\n      // ====== Flèches ======\n      function getGap(track) {\n        var cs = window.getComputedStyle(track);\n        var g = parseFloat(cs.columnGap || cs.gap || 0);\n        return isNaN(g) ? 16 : g;\n      }\n      function scrollOne(direction) {\n        var t = activeTrack();\n        if (!t) return;\n        var card = t.querySelector('.ps-best__card');\n        var step = card ? (card.offsetWidth + getGap(t)) : 280;\n        t.scrollBy({ left: step * direction, behavior: 'smooth' });\n      }\n      if (prevBtn) prevBtn.addEventListener('click', function(e) {\n        e.preventDefault();\n        scrollOne(-1);\n      });\n      if (nextBtn) nextBtn.addEventListener('click', function(e) {\n        e.preventDefault();\n        scrollOne(1);\n      });\n\n      // ====== Drag-to-scroll via Pointer Events ======\n      for (var pi2 = 0; pi2 < panels.length; pi2++) {\n        var track = panels[pi2].querySelector('[data-track]');\n        if (!track) continue;\n        bindDrag(track);\n      }\n\n      function bindDrag(track) {\n        // Bloquer le drag natif HTML5 sur tous les enfants\n        track.addEventListener('dragstart', function(e) {\n          e.preventDefault();\n        });\n\n        var isDown = false;\n        var hasMoved = false;\n        var startX = 0;\n        var startScroll = 0;\n        var activePointerId = null;\n        var THRESHOLD = 6;\n\n        track.addEventListener('pointerdown', function(e) {\n          if (!isDesktop()) return;\n          // mouse : seulement clic gauche\n          if (e.pointerType === 'mouse' && e.button !== 0) return;\n          isDown = true;\n          hasMoved = false;\n          startX = e.clientX;\n          startScroll = track.scrollLeft;\n          activePointerId = e.pointerId;\n          try { track.setPointerCapture(activePointerId); } catch (_) {}\n        });\n\n        track.addEventListener('pointermove', function(e) {\n          if (!isDown) return;\n          var dx = e.clientX - startX;\n          if (!hasMoved && Math.abs(dx) > THRESHOLD) {\n            hasMoved = true;\n            track.classList.add('is-dragging');\n          }\n          if (hasMoved) {\n            e.preventDefault();\n            track.scrollLeft = startScroll - dx;\n          }\n        });\n\n        function endDrag() {\n          if (!isDown) return;\n          isDown = false;\n          if (activePointerId !== null) {\n            try { track.releasePointerCapture(activePointerId); } catch (_) {}\n            activePointerId = null;\n          }\n          // Délai pour laisser le click handler lire hasMoved\n          setTimeout(function() { track.classList.remove('is-dragging'); }, 30);\n        }\n        track.addEventListener('pointerup', endDrag);\n        track.addEventListener('pointercancel', endDrag);\n\n        // Bloquer le click si on a draggé\n        track.addEventListener('click', function(e) {\n          if (hasMoved) {\n            e.preventDefault();\n            e.stopPropagation();\n            e.stopImmediatePropagation();\n            hasMoved = false;\n          }\n        }, true);\n      }\n    }\n\n    function initAll() {\n      var roots = document.querySelectorAll('[data-ps-best]');\n      for (var i = 0; i < roots.length; i++) setupSection(roots[i]);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initAll);\n    } else {\n      initAll();\n    }\n  })();\n</script>",
