    "custom_liquid_JxfdUC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Section CTA finale (bandeau étroit avec image)\n  ------------------------------------------------------------\n  Bandeau ~280px de haut, image hero en background, overlay sombre,\n  texte centré blanc + bouton qui ramène vers la section Collections.\n  Reprend l'image banner_test_2.jpg pour boucler visuellement la page.\n  À placer juste avant le footer.\n  ------------------------------------------------------------\n  PRÉREQUIS : ajouter id=\"collections\" sur le <section class=\"ps-collections\">\n  de ta section Custom Liquid \"Découvrez nos collections\".\n  ============================================================\n{%- endcomment -%}\n\n<style>\n  html { scroll-behavior: smooth; }\n\n  .ps-final-cta {\n    padding: 0 32px;\n    box-sizing: border-box;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }\n  .ps-final-cta__band {\n    position: relative;\n    overflow: hidden;\n    border-radius: 16px;\n    min-height: 280px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    background-color: #1a1a1a;\n  }\n  .ps-final-cta__bg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 0;\n    transition: transform 8s ease-out;\n  }\n  .ps-final-cta__band:hover .ps-final-cta__bg {\n    transform: scale(1.04);\n  }\n  /* Overlay : assombri à gauche+droite, plus sombre au milieu pour lisibilité */\n  .ps-final-cta__band::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.65) 100%);\n    z-index: 1;\n  }\n  .ps-final-cta__content {\n    position: relative;\n    z-index: 2;\n    padding: 40px 28px;\n    max-width: 720px;\n    color: #fff;\n  }\n  .ps-final-cta__eyebrow {\n    display: inline-block;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: rgba(255,255,255,0.78);\n    margin-bottom: 14px;\n  }\n  .ps-final-cta__title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(26px, 3.6vw, 40px);\n    line-height: 1.1;\n    color: #fff;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    margin: 0 0 22px;\n  }\n  .ps-final-cta__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 14px 32px;\n    background-color: #fff;\n    color: #121212;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    text-decoration: none;\n    border: 2px solid #fff;\n    border-radius: 0;\n    cursor: pointer;\n    transition: background-color 0.25s ease, color 0.25s ease;\n  }\n  .ps-final-cta__btn:hover {\n    background-color: transparent;\n    color: #fff;\n  }\n  .ps-final-cta__btn svg {\n    width: 16px;\n    height: 16px;\n    transition: transform 0.25s ease;\n  }\n  .ps-final-cta__btn:hover svg {\n    transform: translateY(-3px);\n  }\n\n  @media (max-width: 767px) {\n    .ps-final-cta { padding: 0 16px; }\n    .ps-final-cta__band { min-height: 260px; }\n    .ps-final-cta__content { padding: 32px 20px; }\n    .ps-final-cta__btn { padding: 13px 26px; }\n  }\n</style>\n\n<section class=\"ps-final-cta\">\n  <div class=\"ps-final-cta__band\">\n\n    <img class=\"ps-final-cta__bg\"\n         src=\"https://pswatches.com/cdn/shop/files/banner_test_2.jpg\"\n         alt=\"\"\n         loading=\"lazy\"\n         width=\"1800\" height=\"600\">\n\n    <div class=\"ps-final-cta__content\">\n      <span class=\"ps-final-cta__eyebrow\">Vous avez tout vu</span>\n      <h2 class=\"ps-final-cta__title\">Prêt à porter votre histoire&nbsp;?</h2>\n      <a href=\"#collections\" class=\"ps-final-cta__btn\">\n        <span>Voir les collections</span>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n          <path d=\"M12 19V5\"/>\n          <path d=\"M5 12l7-7 7 7\"/>\n        </svg>\n      </a>\n    </div>\n\n  </div>\n</section>",
