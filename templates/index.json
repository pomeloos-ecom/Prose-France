    "custom_liquid_aUHxXe": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{% comment %} DOCK — Video Section — Option A (épurée) {% endcomment %}\n<style>\n  .dock-video-wrap {\n    background: #f7f6f3;\n    padding: 0;\n    margin: 0 -48px;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n  .dock-video-inner {\n    max-width: 860px;\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n  .dock-video-player {\n    position: relative;\n    border-radius: 20px;\n    overflow: hidden;\n    background: #111;\n    aspect-ratio: 16/9;\n    border: 3px solid #E5D5B7;\n    cursor: pointer;\n  }\n  .dock-video-player video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .dock-video-overlay {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: rgba(0,0,0,0.2);\n    transition: opacity 0.25s ease;\n    cursor: pointer;\n    z-index: 10;\n  }\n  .dock-video-play-btn {\n    width: 72px;\n    height: 72px;\n    border-radius: 50%;\n    background: #ffffff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    pointer-events: none;\n  }\n  .dock-video-dur {\n    position: absolute;\n    bottom: 16px;\n    right: 20px;\n    font-size: 12px;\n    font-weight: 600;\n    color: rgba(255,255,255,0.55);\n    letter-spacing: 0.06em;\n    font-family: Helvetica, Arial, sans-serif;\n    pointer-events: none;\n    line-height: 1.5;\n  }\n  .dock-video-label {\n    position: absolute;\n    bottom: 16px;\n    left: 20px;\n    font-size: 11px;\n    font-weight: 400;\n    color: rgba(255,255,255,0.35);\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    font-family: Helvetica, Arial, sans-serif;\n    pointer-events: none;\n    line-height: 1.5;\n  }\n  @media (max-width: 720px) {\n    .dock-video-wrap {\n      margin: 0 -24px;\n      padding: 0;\n    }\n    .dock-video-inner {\n      padding: 0 16px;\n    }\n    .dock-video-player {\n      border-radius: 14px;\n      border-width: 2px;\n    }\n  }\n</style>\n<div class=\"dock-video-wrap\">\n  <div class=\"dock-video-inner\">\n    <div class=\"dock-video-player\"\n         onclick=\"\n           var v = this.querySelector('video');\n           var o = this.querySelector('.dock-video-overlay');\n           if (o.style.display !== 'none') {\n             v.play();\n             o.style.display = 'none';\n           } else {\n             v.pause();\n             o.style.display = 'flex';\n           }\n         \">\n      <video\n        src=\"https://cdn.shopify.com/videos/c/o/v/5469984962b64a618dda6f0a19407216.mp4\"\n        poster=\"https://cdn.shopify.com/s/files/1/0947/2147/4892/files/hf_20260508_222216_5b1a30ac-5fc8-4f17-bb56-e23887c56c3a.png?v=1778279168\"\n        playsinline\n        preload=\"none\"\n        onended=\"this.currentTime=0; this.parentNode.querySelector('.dock-video-overlay').style.display='flex';\"\n      ></video>\n      <div class=\"dock-video-overlay\">\n        <div class=\"dock-video-play-btn\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 26 26\" fill=\"#111\" style=\"margin-left:4px\">\n            <path d=\"M6 4l17 9-17 9V4z\"/>\n          </svg>\n        </div>\n      </div>\n      <div class=\"dock-video-label\"></div>\n      <div class=\"dock-video-dur\">0:30</div>\n    </div>\n  </div>\n</div>",
