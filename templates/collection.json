    "custom_liquid_hUzb6A": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Collection Banner (image + breadcrumb + titre + promo)\n  ------------------------------------------------------------\n  À coller dans : Theme editor → Collection page template\n                  → Add section → Custom Liquid\n                  (puis cacher le bloc \"Collection banner\" natif)\n  ------------------------------------------------------------\n  Contenu :\n  1. Image background PLEINE LARGEUR (kill du padding du wrapper Shopify)\n     - utilise {{ collection.image }} si défini dans l'admin Shopify\n     - sinon fallback sur l'image actuelle de Fable\n  2. Overlay sombre dégradé renforcé pour lisibilité du texte blanc\n  3. Promo \"20 % DE REMISE...\" en HAUT, blanc, uppercase, gros texte,\n     SANS arrière-plan (taille proche du titre de collection)\n  4. Breadcrumb bottom-left : \"Collections / NOM-DE-COLLECTION\"\n  5. Titre H1 bottom-left : \"Collection NOM-DE-COLLECTION\"\n  6. Hauteur : 450px desktop / 200px mobile\n  ============================================================\n{%- endcomment -%}\n\n{%- assign fallback_img = \"https://pswatches.com/cdn/shop/files/hf_20260603_121124_0958e3a3-2f18-45f9-835b-4beeee266b03.jpg\" -%}\n{%- if collection.image -%}\n  {%- assign bg_url = collection.image | image_url: width: 1800 -%}\n{%- else -%}\n  {%- assign bg_url = fallback_img -%}\n{%- endif -%}\n\n<style>\n  /* ===== Override des wrappers Shopify pour banner FULL-WIDTH =====\n     Annule le padding latéral du .page-width ET le padding vertical\n     du .section--padding, scopé via :has() à cette section uniquement. */\n  .section--padding:has(.ps-cbanner) {\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n  }\n  .page-width:has(.ps-cbanner) {\n    padding-inline: 0 !important;\n    max-width: none !important;\n  }\n\n  .ps-cbanner {\n    position: relative;\n    width: 100%;\n    height: 450px;\n    overflow: hidden;\n    background-color: #1a1a1a;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    color: #fff;\n  }\n  .ps-cbanner__bg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    z-index: 0;\n  }\n  /* Overlay assombri pour rendre l'image plus sombre + lisibilité texte blanc */\n  .ps-cbanner__overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.40) 50%, rgba(0,0,0,0.65) 100%);\n    z-index: 1;\n  }\n\n  /* ===== Promo en HAUT, blanc, uppercase, sans arrière-plan ===== */\n  .ps-cbanner__promo {\n    position: absolute;\n    z-index: 3;\n    top: 36px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 100%;\n    max-width: 92%;\n    text-align: center;\n    background: transparent;\n    color: #fff;\n    /* Transparence 80% */\n    opacity: 0.8;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(28px, 5vw, 64px);\n    letter-spacing: 0.01em;\n    line-height: 1.05;\n    text-transform: uppercase;\n    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.45);\n    margin: 0;\n    padding: 0;\n  }\n  /* Le <br> n'apparaît qu'en mobile (ci-dessous) */\n  .ps-cbanner__promo-br { display: none; }\n\n  /* ===== Zone breadcrumb + titre (bottom-left) ===== */\n  .ps-cbanner__content {\n    position: relative;\n    z-index: 2;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 40px 48px;\n    box-sizing: border-box;\n  }\n\n  /* Breadcrumb */\n  .ps-cbanner__breadcrumb {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 400;\n    color: #fff;\n    margin: 0 0 12px;\n    letter-spacing: 0.04em;\n    line-height: 1;\n  }\n  .ps-cbanner__breadcrumb a {\n    color: #fff;\n    text-decoration: none;\n    opacity: 0.9;\n    transition: opacity 0.2s ease;\n  }\n  .ps-cbanner__breadcrumb a:hover { opacity: 1; }\n  .ps-cbanner__breadcrumb-sep {\n    display: inline-block;\n    margin: 0 8px;\n    opacity: 0.5;\n  }\n  .ps-cbanner__breadcrumb-current {\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n  }\n\n  /* Titre H1 — Collection NOM */\n  .ps-cbanner__title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(36px, 6.5vw, 96px);\n    line-height: 1;\n    color: #fff;\n    margin: 0;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n  }\n\n  /* ===== Mobile (< 768px) — hauteur 200px max ===== */\n  @media (max-width: 767px) {\n    .ps-cbanner { height: 200px; }\n\n    .ps-cbanner__promo {\n      top: 14px;\n      font-size: clamp(16px, 5vw, 26px);\n      max-width: calc(100% - 24px);\n      text-shadow: 0 2px 8px rgba(0,0,0,0.5);\n    }\n    /* Active la coupure sur 2 lignes uniquement en mobile */\n    .ps-cbanner__promo-br { display: inline; }\n\n    .ps-cbanner__content { padding: 14px 16px; }\n    .ps-cbanner__breadcrumb { font-size: 11px; margin: 0 0 5px; }\n    .ps-cbanner__title { font-size: clamp(18px, 6.5vw, 32px); }\n  }\n</style>\n\n<section class=\"ps-cbanner\" aria-label=\"Bannière de collection\">\n\n  {%- comment -%} ===== Image de fond ===== {%- endcomment -%}\n  <img class=\"ps-cbanner__bg\"\n       src=\"{{ bg_url }}\"\n       alt=\"{{ collection.title | escape }}\"\n       loading=\"eager\"\n       width=\"1800\" height=\"600\">\n\n  {%- comment -%} ===== Overlay sombre renforcé ===== {%- endcomment -%}\n  <span class=\"ps-cbanner__overlay\" aria-hidden=\"true\"></span>\n\n  {%- comment -%} ===== Promo en haut (blanc, uppercase, pas de bg) ===== {%- endcomment -%}\n  <p class=\"ps-cbanner__promo\">\n    20&nbsp;% de remise<br class=\"ps-cbanner__promo-br\" aria-hidden=\"true\"> pour 2 montres ou +\n  </p>\n\n  {%- comment -%} ===== Breadcrumb + titre H1 (bottom-left) ===== {%- endcomment -%}\n  <div class=\"ps-cbanner__content\">\n    <nav class=\"ps-cbanner__breadcrumb\" aria-label=\"Fil d'ariane\">\n      <a href=\"/collections\">Collections</a>\n      <span class=\"ps-cbanner__breadcrumb-sep\" aria-hidden=\"true\">/</span>\n      <span class=\"ps-cbanner__breadcrumb-current\">{{ collection.title }}</span>\n    </nav>\n    <h1 class=\"ps-cbanner__title\">Collection {{ collection.title }}</h1>\n  </div>\n\n</section>",
        "color_text": "",
