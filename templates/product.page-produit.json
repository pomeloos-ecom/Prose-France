        "liquid_GmGGRg": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Badges paiement sous \"Ajouter au panier\"\n  À coller dans la section \"Product information\",\n  juste sous le bouton \"Ajouter au panier\"\n  (Add Block → Custom Liquid).\n  ------------------------------------------------------------\n  Affiche en une seule ligne :\n  Google Pay, Apple Pay, Shop Pay, PayPal, Mastercard, Visa, Klarna\n  ============================================================\n{%- endcomment -%}\n\n{%- assign payment_types = \"google_pay,apple_pay,shopify_pay,paypal,master,visa,klarna\" | split: \",\" -%}\n\n<style>\n  .ps-pay {\n    margin: 12px 0 8px;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, sans-serif;\n    line-height: 1;\n  }\n  .ps-pay__label {\n    text-align: center;\n    font-size: 13px;\n    color: #4a4a4a;\n    margin: 0;\n    line-height: 1.2;\n  }\n  .ps-pay__list {\n    display: flex;\n    flex-wrap: nowrap;\n    justify-content: center;\n    align-items: center;\n    gap: 8px;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n  .ps-pay__list li { display: inline-flex; flex-shrink: 0; }\n  .ps-pay__list svg {\n    height: 24px;\n    width: auto;\n    display: block;\n  }\n  @media (max-width: 480px) {\n    .ps-pay__list { gap: 6px; }\n    .ps-pay__list svg { height: 20px; }\n  }\n</style>\n\n<div class=\"ps-pay\">\n  <p class=\"ps-pay__label\">Paiement crypté et sécurisé</p>\n  <ul class=\"ps-pay__list\">\n    {%- for type in payment_types -%}\n      <li>{{ type | payment_type_svg_tag: class: 'ps-pay-icon' }}</li>\n    {%- endfor -%}\n  </ul>\n</div>"
