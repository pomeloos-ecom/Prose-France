    "custom_liquid_Kiwqme": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Section \"Avis clients\" (masonry + Voir plus)\n  ------------------------------------------------------------\n  - 70 avis pré-chargés (15 visibles, 55 cachés au départ)\n  - Bouton \"Voir plus\" révèle 7 avis par clic avec fondu staggered\n  - Layout masonry CSS pur (colonnes), responsive\n  - Performance : content-visibility: auto sur chaque card\n  - Étoiles SVG inline + ratings variables (1-5)\n  ============================================================\n{%- endcomment -%}\n\n{%- assign reveal_batch = 7 -%}\n{%- assign star_color   = \"#01B57E\" -%}\n\n<style>\n  .ps-reviews {\n    padding: 60px 32px;\n    background-color: #F9F4F1;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, sans-serif;\n  }\n  .ps-reviews__inner { max-width: 1440px; margin: 0 auto; }\n\n  .ps-reviews__header { text-align: center; margin: 0 0 36px; }\n  .ps-reviews__title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(26px, 3vw, 38px);\n    line-height: 1.1;\n    color: #171717;\n    text-transform: uppercase;\n    margin: 0 0 10px;\n  }\n  .ps-reviews__subtitle {\n    font-size: 15px;\n    color: #4a4a4a;\n    margin: 0 auto;\n    max-width: 720px;\n    line-height: 1.5;\n  }\n\n  .ps-reviews__grid {\n    column-count: 4;\n    column-gap: 16px;\n  }\n  @media (max-width: 1100px) { .ps-reviews__grid { column-count: 3; } }\n  @media (max-width: 768px)  { .ps-reviews__grid { column-count: 2; } }\n  @media (max-width: 480px)  { .ps-reviews__grid { column-count: 1; } }\n\n  .ps-reviews__card {\n    break-inside: avoid;\n    page-break-inside: avoid;\n    background-color: #fff;\n    border-radius: 8px;\n    border: 1px solid rgba(0,0,0,0.06);\n    padding: 16px 18px;\n    margin: 0 0 16px;\n    content-visibility: auto;\n    contain-intrinsic-size: 0 200px;\n  }\n  .ps-reviews__card.is-hidden { display: none; }\n  .ps-reviews__card.just-revealed { animation: ps-reviews-fade 0.55s ease both; }\n  @keyframes ps-reviews-fade {\n    from { opacity: 0; transform: translateY(14px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n\n  /* Photo client : format landscape uniforme 4:3 avec crop centré */\n  .ps-reviews__photo {\n    display: block;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n    object-position: center;\n    border-radius: 6px;\n    margin: 0 0 12px;\n    background-color: #F0EAE3;\n  }\n\n  .ps-reviews__name {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 14.5px;\n    font-weight: 700;\n    color: #171717;\n    margin: 0 0 6px;\n  }\n  /* Étoiles style Trustoo : rounded square avec étoile cutout */\n  .ps-reviews__stars { display: inline-flex; align-items: center; gap: 2px; margin: 0 0 8px; }\n  .ps-reviews__star { width: 15px; height: 16px; display: block; }\n  .ps-reviews__star--filled { color: {{ star_color }}; }\n  .ps-reviews__star--empty  { color: #D0D0D0; }\n\n  /* Badge \"Achat vérifié\" sous le nom */\n  .ps-reviews__verified {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 11px;\n    font-weight: 500;\n    color: #6b6b6b;\n    margin: 0 0 8px;\n    line-height: 1;\n  }\n  .ps-reviews__verified-icon {\n    width: 13px;\n    height: 13px;\n    display: block;\n    flex-shrink: 0;\n  }\n\n  .ps-reviews__rev-title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13.5px;\n    font-weight: 700;\n    line-height: 1.3;\n    color: #171717;\n    margin: 0 0 4px;\n  }\n  .ps-reviews__text {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13.5px;\n    font-weight: 400;\n    line-height: 1.45;\n    color: #2D2D2D;\n    margin: 0;\n  }\n\n  .ps-reviews__more-wrap { text-align: center; margin-top: 32px; }\n  .ps-reviews__more {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 13px 28px;\n    background-color: transparent;\n    color: #121212;\n    border: 2px solid #121212;\n    border-radius: 0;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    cursor: pointer;\n    transition: background-color 0.25s ease, color 0.25s ease;\n  }\n  .ps-reviews__more:hover { background-color: #121212; color: #fff; }\n  .ps-reviews__more[hidden] { display: none; }\n\n  @media (max-width: 640px) {\n    .ps-reviews { padding: 50px 16px; }\n    .ps-reviews__card { padding: 14px 16px; }\n    .ps-reviews__name { font-size: 14px; }\n    .ps-reviews__rev-title { font-size: 13px; }\n    .ps-reviews__text { font-size: 13px; }\n  }\n</style>\n\n{%- comment -%} ===== Étoile pleine + vide (style Trustoo : rounded square + étoile cutout) ===== {%- endcomment -%}\n{%- capture star_filled -%}<svg class=\"ps-reviews__star ps-reviews__star--filled\" viewBox=\"0 0 18 19\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M5.4 0.565613C2.41766 0.565613 0 2.98328 0 5.96561V13.1656C0 16.1479 2.41766 18.5656 5.4 18.5656H12.6C15.5823 18.5656 18 16.1479 18 13.1656V5.96561C18 2.98328 15.5823 0.565613 12.6 0.565613H5.4ZM10.3718 7.67804L9.00041 3.73275L7.62903 7.67804L3.45306 7.76314L6.78147 10.2866L5.57196 14.2844L9.00041 11.8987L12.4289 14.2844L11.2194 10.2866L14.5478 7.76314L10.3718 7.67804Z\"/></svg>{%- endcapture -%}\n{%- capture star_empty -%}<svg class=\"ps-reviews__star ps-reviews__star--empty\" viewBox=\"0 0 18 19\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M5.4 0.565613C2.41766 0.565613 0 2.98328 0 5.96561V13.1656C0 16.1479 2.41766 18.5656 5.4 18.5656H12.6C15.5823 18.5656 18 16.1479 18 13.1656V5.96561C18 2.98328 15.5823 0.565613 12.6 0.565613H5.4ZM10.3718 7.67804L9.00041 3.73275L7.62903 7.67804L3.45306 7.76314L6.78147 10.2866L5.57196 14.2844L9.00041 11.8987L12.4289 14.2844L11.2194 10.2866L14.5478 7.76314L10.3718 7.67804Z\"/></svg>{%- endcapture -%}\n\n{%- comment -%} ===== Badge \"Achat vérifié\" : coche noir/blanc ===== {%- endcomment -%}\n{%- capture verified_badge -%}<p class=\"ps-reviews__verified\"><svg class=\"ps-reviews__verified-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"8\" fill=\"#171717\"/><path d=\"M4.8 8.3l2.2 2.2 4.2-4.5\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/></svg>Achat vérifié</p>{%- endcapture -%}\n{%- capture stars_5 -%}{{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_filled }}{%- endcapture -%}\n{%- capture stars_4 -%}{{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_empty }}{%- endcapture -%}\n{%- capture stars_3 -%}{{ star_filled }}{{ star_filled }}{{ star_filled }}{{ star_empty }}{{ star_empty }}{%- endcapture -%}\n\n<section class=\"ps-reviews\" data-ps-reviews>\n  <div class=\"ps-reviews__inner\">\n\n    <header class=\"ps-reviews__header\">\n      <h2 class=\"ps-reviews__title\">Ils nous font confiance</h2>\n      <p class=\"ps-reviews__subtitle\">Grâce à vos recommandations, nous pouvons continuer à vous offrir le meilleur rapport qualité-prix tout en faisant découvrir notre savoir-faire à de nouveaux passionnés.</p>\n    </header>\n\n    <div class=\"ps-reviews__grid\">\n\n      {%- comment -%} ===== 1-15 : VISIBLES ===== {%- endcomment -%}\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0007_REMOVE-LOGO-2_f58400fb-8967-4612-ab10-4aed2f1dc512.png?v=1780270528\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Daniel Rodriguez</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">J'adore ma nouvelle montre, un véritable bijou</p><p class=\"ps-reviews__text\">Je la porte tous les jours et j'ai reçu tellement de compliments que je ne peux pas m'empêcher de l'admirer, une pièce vraiment magnifique. Fortement recommandée.</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0006_logo-blanc_5d0e5181-25d5-480a-ae38-7ccedaec18eb.png?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Brandon Guy</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">J'adore vraiment cette montre</p><p class=\"ps-reviews__text\">Je ne peux pas me permettre une Rolex, mais je me sens tellement bien en portant cette montre. Son look, son poids et sa précision m'ont surpris, et je vais en acheter une autre !</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0010_logo-noir_fee85ad2-08ae-4b21-b528-439a0c22da43.png?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Hugo Goodman</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Valeur incroyable</p><p class=\"ps-reviews__text\">J'adore cette montre ! Ma nouvelle préférée. Très haute qualité et très durable. Elle tient parfaitement sur mon poignet et je suis très content du style. J'aime aussi les outils fournis !</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0008_logo-blanc_59989338-0a1a-4f97-8568-db5508bb1a38.png?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Abraham Cyriax</h3>{{ verified_badge }}<p class=\"ps-reviews__text\">J'ai acheté 3 montres pour profiter de l'offre et je suis très satisfait de mon achat. Les 3 montres paraissent bien plus chères que leur prix et j'ai reçu beaucoup de compliments.</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0002_logo-noir_00576422-e724-41fa-a088-8181192d4295.png?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Antoine Cali</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Bonne montre</p><p class=\"ps-reviews__text\">Montre solide ! J'aime beaucoup.</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0005_logo-blanc_281ad688-943d-4331-8f1d-78a7e9ea4dec.png?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Rémi Parrott</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Parfaite pour tous les jours</p><p class=\"ps-reviews__text\">Parfaite pour tous les jours. Fonction et poids très agréables.</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/0000_logo-blanc_dbc5e9cf-27e2-456e-9026-3191b96e0cc0.png?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Brock T.O.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Absolument incroyable !</p><p class=\"ps-reviews__text\">Absolument incroyable ! Je vais définitivement en commander d'autres !</p></article>\n\n      <article class=\"ps-reviews__card\"><img class=\"ps-reviews__photo\" src=\"https://cdn.shopify.com/s/files/1/0787/4818/9014/files/ceb51e88-1773-4cc7-a489-629fd670086f.jpg?v=1780270527\" alt=\"Photo avis client\" loading=\"lazy\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Kendall S.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Meilleure qualité</p><p class=\"ps-reviews__text\">Meilleure qualité que ce à quoi je m'attendais initialement.</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Jason C.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Superbe garde-temps</p><p class=\"ps-reviews__text\">Superbe pièce ! J'adore le GMT et elle s'adapte parfaitement à mon poignet.</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Raymond S.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Quelle superbe qualité</p><p class=\"ps-reviews__text\">Je suis vraiment satisfait des montres dans l'ensemble — la qualité et le confort sont au rendez-vous.</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Ben</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Qualité incroyable pour un prix correct</p><p class=\"ps-reviews__text\">Montre magnifique. Beaucoup de compliments. Je commanderai à nouveau !</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Daniel Rodriguez</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Incroyable</p><p class=\"ps-reviews__text\">J'adore cette montre, elle est tellement belle ! Super qualité en acier inoxydable et mouvement, on a l'impression qu'elle peut durer toute une vie.</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Franck N.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Belle montre</p><p class=\"ps-reviews__text\">Cette montre est incroyable ! Elle est arrivée en parfait état. Je l'adore !</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Douglas P.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre très élégante</p><p class=\"ps-reviews__text\">Elle est incroyablement solide, a du poids, le bracelet est parfait.</p></article>\n\n      <article class=\"ps-reviews__card\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Cayman S.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Exactement comme décrit</p><p class=\"ps-reviews__text\">Boîtier solide, verre clair, bonne sensation et matériaux de qualité. Pas de doute, ce sont de belles montres.</p></article>\n\n      {%- comment -%} ===== 16-70 : CACHÉS au départ ===== {%- endcomment -%}\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Michel</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre fantastique et bien construite</p><p class=\"ps-reviews__text\">Exactement comme décrit. Excellente qualité.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Saurabh Patel</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Mieux que prévu !</p><p class=\"ps-reviews__text\">Je recommande vivement cette montre si vous cherchez une pièce de qualité, confortable à porter et facile à ajuster à votre poignet.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Dominique E.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Super</p><p class=\"ps-reviews__text\">Montre très belle. Le bracelet est facile à ajuster.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Joshua Alexandre</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Excellente montre</p><p class=\"ps-reviews__text\">Il y a une raison pour laquelle cette couleur est si prisée en ce moment. Les matériaux sont de haute qualité à un prix étonnamment juste.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Hassan K.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Sympa</p><p class=\"ps-reviews__text\">Montre incroyable. C'est exactement ce que je voulais. Super qualité et excellent savoir-faire. L'expérience de déballage était parfaite.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Carlos Gonzales</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre</p><p class=\"ps-reviews__text\">J'ai adoré le site et les modèles. Il était difficile de trouver une montre 10ATM. Très bonne qualité, je suis très satisfait.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Denz</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montres solides</p><p class=\"ps-reviews__text\">La boîte fournie était exceptionnelle, et j'ai immédiatement utilisé l'outil. Cela a rendu l'expérience de déballage agréable.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Travis Barnard</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Génial !</p><p class=\"ps-reviews__text\">Outil très pratique et boîte élégante. Le savoir-faire est superbe.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Brent Rayford</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Classique et élégante</p><p class=\"ps-reviews__text\">Qualité fantastique. Excellent service client.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Davis L.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">J'adore</p><p class=\"ps-reviews__text\">Je suis très satisfait de cette montre. Le design est intemporel, élégant et classe, ce qui la rend adaptée aux occasions formelles et au quotidien. L'artisanat est vraiment impressionnant.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Edwin R.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Vous ne serez pas déçu</p><p class=\"ps-reviews__text\">Je l'adore vraiment et apprécie la qualité et le style qu'elle apporte. Cette montre est rapidement devenue l'un de mes accessoires préférés.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Carlos V.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">J'adore cette montre, elle est parfaite</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Nosakhare J.O.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Pièce incroyable</p><p class=\"ps-reviews__text\">Excellentes montres pour le prix.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Rémi W.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Encore une</p><p class=\"ps-reviews__text\">Ce sont d'excellentes montres. J'ai profité de l'offre et pour le prix, elles sont super. Je recommande de les essayer.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Albert G.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">La montre est belle et agréable à porter</p><p class=\"ps-reviews__text\">Excellente qualité et très bon prix.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Ahmad IK</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Très élégante et assortie au Santos Cartier</p><p class=\"ps-reviews__text\">Exceptionnelles et exactement comme décrit.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Darius W.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre de haute qualité</p><p class=\"ps-reviews__text\">Au début, j'avais peur de dépenser, mais à l'arrivée, c'était exactement ce que je voulais, et j'ai voulu en acheter d'autres.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Marc M.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">La montre est bien construite, qualité précise</p><p class=\"ps-reviews__text\">Très belle montre, bracelet incroyable, cadran net. Garde l'heure. Si vous voulez une bonne montre pour un prix raisonnable, c'est celle-ci.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Daniel Rodriguez</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Marque et montres incroyables</p><p class=\"ps-reviews__text\">Je suis extrêmement impressionné par mes montres. La qualité de fabrication est exceptionnelle, chaque détail est précis et soigné. Le design est à la fois moderne et intemporel.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Daniel Rodriguez</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre époustouflante</p><p class=\"ps-reviews__text\">Montre superbe. Elle réussit parfaitement à être à la fois habillée et décontractée. Le cadran a une couleur unique qui attire l'attention et lui donne une vraie présence au poignet.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Rémi</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre belle, sensation de haute qualité</p><p class=\"ps-reviews__text\">Belle montre, sensation de qualité. L'expédition a été rapide et les réponses du service client prenaient moins de 10 minutes.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Abraham Cyriax</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Pièce intemporelle</p><p class=\"ps-reviews__text\">L'Oyster Datejust est une pièce classique que j'aime porter au quotidien. Elle est bien faite et attire vraiment l'œil.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Antoine Cali</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Montre très esthétique</p><p class=\"ps-reviews__text\">Superbe montre. Le bracelet en caoutchouc bleu lui donne un style plus décontracté, parfait pour le bureau ou la vie de tous les jours.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Rémi Parrott</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Parfaite</p><p class=\"ps-reviews__text\">Qualité parfaite.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_4 }}</div><h3 class=\"ps-reviews__name\">Hugo Goodman</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Cadran sympa, boîtier agréable, bracelet</p><p class=\"ps-reviews__text\">Beau cadran, beau boîtier et jolis bracelets. Les bords lisses et les bons maillons donnent une vraie impression de qualité.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Jean</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Incroyable</p><p class=\"ps-reviews__text\">J'adore cette montre. Je reçois des compliments tous les jours !</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Thoreau</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">J'adore ma montre</p><p class=\"ps-reviews__text\">J'adore ma montre. Bien construite et je reçois beaucoup de compliments. J'en rachèterai une autre !</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Maxime Logan</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Qualité incroyable</p><p class=\"ps-reviews__text\">Qualité incroyable, service client et expédition ultra rapides, j'ai hâte d'en commander d'autres.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Jack</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Site légitime</p><p class=\"ps-reviews__text\">Réactifs. Je rachèterai.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Robert D.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Acheté cette montre dans le cadre d'une offre</p><p class=\"ps-reviews__text\">Je suis vraiment content de cet achat et impressionné par les composants utilisés et la finition générale. Très agréable à porter.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Antoine</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">L'entreprise communique très bien par email</p><p class=\"ps-reviews__text\">Si vous envoyez un email, ils répondent rapidement, et quand vous recevez la montre, vous ne regretterez pas. Belle qualité, beau design.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_3 }}</div><h3 class=\"ps-reviews__name\">Moreno Moreno</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">La montre est superbe</p><p class=\"ps-reviews__text\">La montre est superbe mais le bracelet est un peu abîmé, je n'ai donc pas encore eu l'occasion de la porter.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Travis Barnard</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Génial !</p><p class=\"ps-reviews__text\">Excellente montre. Fonctionne bien et le design Seiko reste indémodable.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Jasmine C.</h3>{{ verified_badge }}<p class=\"ps-reviews__text\">Très belle montre, élégante au quotidien comme en soirée. La taille me va parfaitement.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Joachim</h3>{{ verified_badge }}<p class=\"ps-reviews__text\">Très bien.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Sunny Patel</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Quelle belle montre</p><p class=\"ps-reviews__text\">Quelle magnifique montre, une véritable œuvre d'art. Je n'arrête pas de recevoir des compliments quand je la porte.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Zack Levesque</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Meilleure qualité jamais vue</p><p class=\"ps-reviews__text\">Ces montres sont d'une qualité incroyable ! Mais les vrais compliments reviennent à l'équipe qui travaille ici.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Nelson D.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Stylée</p><p class=\"ps-reviews__text\">On sent la qualité de cette montre ! Et le service client est au top ! Réponses rapides et précises.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Christophe Hudson</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Excité</p><p class=\"ps-reviews__text\">Excellente qualité et excellent rapport qualité-prix. La montre était entièrement protégée pour éviter tout dommage lors de l'expédition, dans une belle boîte avec un outil d'ajustement.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Nathan Neale</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Très belle montre</p><p class=\"ps-reviews__text\">Très belle qualité, c'est ma montre du quotidien à 100 %.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Joshua S.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Fantastique</p><p class=\"ps-reviews__text\">Cette montre est magnifique au poignet, facile à ajuster et fonctionne mieux que prévu. Elle attire immédiatement les regards.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Norbert K.</h3>{{ verified_badge }}<p class=\"ps-reviews__text\">Belle montre, j'aime la porter.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Daniel</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Seiko Submariner</p><p class=\"ps-reviews__text\">Au-delà de son esthétique, la montre fonctionne à merveille. Le mouvement automatique est un véritable moteur, offrant une précision et une fiabilité remarquables.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Bubba</h3>{{ verified_badge }}<p class=\"ps-reviews__text\">Très impressionné par ces montres. L'expédition a pris un peu de temps, mais cela en valait la peine !</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Ernest</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Excellente qualité</p><p class=\"ps-reviews__text\">Super look, super sensation. Absolument à la hauteur du prix.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Maxime</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Génial !</p><p class=\"ps-reviews__text\">La montre est arrivée en excellent état, bien emballée et protégée. Conforme à la description, tant visuellement que fonctionnellement. Superbe montre.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Marc</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Seitona or rose</p><p class=\"ps-reviews__text\">La qualité est superbe. Si vous cherchez une montre qui attire le regard, vous ne pouvez pas vous tromper.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Scott P.</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Ça vaut le coup</p><p class=\"ps-reviews__text\">C'est presque agaçant à quel point elle est belle, surtout après avoir porté une Rolex pendant des années. Je vais probablement en acheter plusieurs.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Rick</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Échangée pour une Panda</p><p class=\"ps-reviews__text\">À part ma Bruce Wayne, c'est devenu ma montre du quotidien. Je ne peux pas assez souligner la qualité et le savoir-faire. Je viens de passer ma deuxième commande.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Sneh</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Je ne m'attendais pas à ce que cette montre soit ainsi</p><p class=\"ps-reviews__text\">Je ne m'attendais pas à ce que cette montre soit aussi bonne.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">Russel Fahey</h3>{{ verified_badge }}<p class=\"ps-reviews__text\">Vraiment haute qualité.</p></article>\n\n      <article class=\"ps-reviews__card is-hidden\"><div class=\"ps-reviews__stars\">{{ stars_5 }}</div><h3 class=\"ps-reviews__name\">André</h3>{{ verified_badge }}<p class=\"ps-reviews__rev-title\">Vraiment content</p><p class=\"ps-reviews__text\">Vraiment content de la montre ! Elle est superbe et le bracelet était facile à ajuster. Je prévois d'en racheter.</p></article>\n\n    </div>\n\n    <div class=\"ps-reviews__more-wrap\">\n      <button class=\"ps-reviews__more\" data-reviews-more type=\"button\">\n        Voir plus d'avis\n      </button>\n    </div>\n\n  </div>\n</section>\n\n<script>\n  (function() {\n    'use strict';\n    var root = document.querySelector('[data-ps-reviews]');\n    if (!root) return;\n    var btn = root.querySelector('[data-reviews-more]');\n    var BATCH = {{ reveal_batch }};\n    var STAGGER_MS = 50;\n\n    function countHidden() {\n      return root.querySelectorAll('.ps-reviews__card.is-hidden').length;\n    }\n    function updateBtn() {\n      btn.hidden = countHidden() <= 0;\n    }\n\n    updateBtn();\n\n    btn.addEventListener('click', function() {\n      var hidden = root.querySelectorAll('.ps-reviews__card.is-hidden');\n      var revealed = 0;\n      for (var i = 0; i < hidden.length && revealed < BATCH; i++) {\n        (function(card, delay) {\n          card.style.animationDelay = delay + 'ms';\n          card.classList.remove('is-hidden');\n          card.classList.add('just-revealed');\n          setTimeout(function() {\n            card.classList.remove('just-revealed');\n            card.style.animationDelay = '';\n          }, 600 + delay);\n        })(hidden[i], revealed * STAGGER_MS);\n        revealed++;\n      }\n      updateBtn();\n    });\n  })();\n</script>",
