    "custom_liquid_TdnUiV": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Section de clôture FAQ : \"Encore une question ?\"\n  ------------------------------------------------------------\n  À placer juste après la FAQ sur la page /pages/f-a-q\n  (Theme editor → page FAQ → Add section → Custom Liquid).\n  ------------------------------------------------------------\n  Contenu : card centrée avec\n  - Titre \"Vous avez encore une question ?\"\n  - Sous-titre rassurant\n  - 2 boutons côte à côte :\n      • WhatsApp (vert, primary)\n      • Nous écrire (outline, vers /pages/contactez-nous)\n  - Numéro affiché en dessous (clic pour appeler)\n  ------------------------------------------------------------\n  Modifiable en haut du fichier :\n  - wa_phone, wa_display\n  - contact_url\n  ============================================================\n{%- endcomment -%}\n\n{%- assign wa_phone   = \"33775749541\" -%}\n{%- assign wa_display = \"+33 7 75 74 95 41\" -%}\n{%- assign contact_url = \"https://prosewatches.fr/pages/contactez-nous\" -%}\n\n<style>\n  .ps-faq-cta {\n    background-color: #F9F4F1;\n    padding: 70px 24px 90px;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    color: #171717;\n    box-sizing: border-box;\n  }\n\n  .ps-faq-cta__card {\n    max-width: 760px;\n    margin: 0 auto;\n    background-color: #fff;\n    border-radius: 16px;\n    padding: 48px 40px;\n    text-align: center;\n    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);\n    border: 1px solid rgba(23, 23, 23, 0.06);\n  }\n\n  .ps-faq-cta__icon {\n    width: 56px;\n    height: 56px;\n    margin: 0 auto 22px;\n    border-radius: 50%;\n    background-color: #F4EBE5;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #171717;\n  }\n  .ps-faq-cta__icon svg {\n    width: 26px;\n    height: 26px;\n  }\n\n  .ps-faq-cta__title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(24px, 3vw, 36px);\n    line-height: 1.15;\n    color: #171717;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    margin: 0 0 14px;\n  }\n\n  .ps-faq-cta__subtitle {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 15px;\n    line-height: 1.55;\n    color: #4a4a4a;\n    margin: 0 auto 30px;\n    max-width: 520px;\n  }\n\n  /* ===== Boutons ===== */\n  .ps-faq-cta__buttons {\n    display: flex;\n    justify-content: center;\n    gap: 14px;\n    flex-wrap: wrap;\n    margin: 0 0 24px;\n  }\n  .ps-faq-cta__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    min-width: 220px;\n    padding: 14px 26px;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    text-decoration: none;\n    border: 2px solid;\n    border-radius: 0;\n    cursor: pointer;\n    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;\n    box-sizing: border-box;\n  }\n  .ps-faq-cta__btn svg {\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n  }\n\n  /* WhatsApp primary */\n  .ps-faq-cta__btn--wa {\n    background-color: #21A56E;\n    border-color: #21A56E;\n    color: #fff;\n  }\n  .ps-faq-cta__btn--wa:hover {\n    background-color: #1B8A5C;\n    border-color: #1B8A5C;\n    color: #fff;\n  }\n  .ps-faq-cta__btn--wa svg { fill: currentColor; }\n\n  /* Nous écrire (outline) */\n  .ps-faq-cta__btn--outline {\n    background-color: transparent;\n    border-color: #171717;\n    color: #171717;\n  }\n  .ps-faq-cta__btn--outline:hover {\n    background-color: #171717;\n    color: #fff;\n  }\n  .ps-faq-cta__btn--outline svg {\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  /* ===== Numéro de téléphone discret ===== */\n  .ps-faq-cta__phone {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    color: #6b6b6b;\n    margin: 0;\n    line-height: 1.4;\n  }\n  .ps-faq-cta__phone a {\n    color: #171717;\n    text-decoration: none;\n    font-weight: 600;\n    border-bottom: 1px solid rgba(23, 23, 23, 0.2);\n    padding-bottom: 1px;\n    transition: border-color 0.2s ease, color 0.2s ease;\n  }\n  .ps-faq-cta__phone a:hover {\n    color: #21A56E;\n    border-color: #21A56E;\n  }\n  .ps-faq-cta__phone-note {\n    display: block;\n    font-size: 11.5px;\n    color: #8a8a8a;\n    margin-top: 4px;\n    font-style: normal;\n  }\n\n  /* ===== Mobile ===== */\n  @media (max-width: 640px) {\n    .ps-faq-cta { padding: 50px 16px 70px; }\n    .ps-faq-cta__card { padding: 36px 24px 30px; border-radius: 12px; }\n    .ps-faq-cta__icon { width: 48px; height: 48px; margin-bottom: 18px; }\n    .ps-faq-cta__icon svg { width: 22px; height: 22px; }\n    .ps-faq-cta__title { font-size: clamp(22px, 6vw, 28px); }\n    .ps-faq-cta__subtitle { font-size: 14px; margin-bottom: 24px; }\n\n    .ps-faq-cta__buttons {\n      flex-direction: column;\n      gap: 10px;\n      align-items: stretch;\n    }\n    .ps-faq-cta__btn {\n      width: 100%;\n      min-width: 0;\n      padding: 14px 20px;\n    }\n  }\n</style>\n\n<section class=\"ps-faq-cta\">\n  <div class=\"ps-faq-cta__card\">\n\n    {%- comment -%} ===== Petite icône en pastille ===== {%- endcomment -%}\n    <div class=\"ps-faq-cta__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/>\n      </svg>\n    </div>\n\n    <h2 class=\"ps-faq-cta__title\">Vous avez encore une question&nbsp;?</h2>\n\n    <p class=\"ps-faq-cta__subtitle\">\n      Notre équipe est à votre écoute du lundi au samedi et vous répond\n      généralement en moins de quelques heures.\n    </p>\n\n    {%- comment -%} ===== Boutons WhatsApp + Nous écrire ===== {%- endcomment -%}\n    <div class=\"ps-faq-cta__buttons\">\n\n      <a href=\"https://wa.me/{{ wa_phone }}\"\n         class=\"ps-faq-cta__btn ps-faq-cta__btn--wa\"\n         target=\"_blank\"\n         rel=\"noopener noreferrer\"\n         aria-label=\"Contactez-nous sur WhatsApp\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.488\"/>\n        </svg>\n        <span>WhatsApp</span>\n      </a>\n\n      <a href=\"{{ contact_url }}\"\n         class=\"ps-faq-cta__btn ps-faq-cta__btn--outline\"\n         aria-label=\"Nous écrire\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"/>\n          <polyline points=\"22,6 12,13 2,6\"/>\n        </svg>\n        <span>Nous écrire</span>\n      </a>\n\n    </div>\n\n    {%- comment -%} ===== Numéro WhatsApp discret en dessous ===== {%- endcomment -%}\n    <p class=\"ps-faq-cta__phone\">\n      Ou directement sur notre numéro WhatsApp&nbsp;:\n      <a href=\"https://wa.me/{{ wa_phone }}\" target=\"_blank\" rel=\"noopener noreferrer\">{{ wa_display }}</a>\n    </p>\n\n  </div>\n</section>",
