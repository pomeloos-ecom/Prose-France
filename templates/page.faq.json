    "custom_liquid_M3rQii": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "liquid": "{%- comment -%}\n  ============================================================\n  PS WATCHES — Section FAQ \"Vos questions\" (3 onglets)\n  ------------------------------------------------------------\n  Reproduction fidèle de la section FAQ de la page produit Haïku.\n  Réutilisable sur n'importe quelle page (produit, collection,\n  page custom, etc.).\n  ------------------------------------------------------------\n  Structure :\n  - Titre \"VOS QUESTIONS\" centré uppercase\n  - 3 onglets pill : \"Votre montre\" / \"Envoi & livraison\" / \"Notre concept\"\n  - Sous chaque onglet : accordion de Q/R (1 ouvert à la fois)\n  ------------------------------------------------------------\n  À coller dans : Theme editor → Add section → Custom Liquid\n  ============================================================\n{%- endcomment -%}\n\n<style>\n  .ps-faq {\n    background-color: #F9F4F1;\n    padding: 70px 32px;\n    font-family: \"Red Hat Display\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    color: #171717;\n  }\n  .ps-faq__inner {\n    max-width: 880px;\n    margin: 0 auto;\n  }\n\n  /* ===== Titre ===== */\n  .ps-faq__title {\n    font-family: \"Red Hat Display\", sans-serif;\n    font-weight: 900;\n    font-size: clamp(32px, 4vw, 50px);\n    line-height: 1;\n    color: #171717;\n    text-align: center;\n    text-transform: uppercase;\n    letter-spacing: -0.01em;\n    margin: 0 0 36px;\n  }\n\n  /* ===== Onglets ===== */\n  .ps-faq__tabs {\n    display: inline-flex;\n    margin: 0 auto 36px;\n    padding: 5px;\n    background-color: transparent;\n    border: 1.5px solid #171717;\n    border-radius: 999px;\n    gap: 0;\n  }\n  .ps-faq__tabs-wrap {\n    text-align: center;\n  }\n  .ps-faq__tab {\n    appearance: none;\n    border: 0;\n    background-color: transparent;\n    color: #171717;\n    padding: 11px 22px;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    line-height: 1;\n    border-radius: 999px;\n    cursor: pointer;\n    transition: background-color 0.25s ease, color 0.25s ease;\n    white-space: nowrap;\n  }\n  .ps-faq__tab:hover:not(.is-active) {\n    background-color: rgba(0,0,0,0.04);\n  }\n  .ps-faq__tab.is-active {\n    background-color: #171717;\n    color: #fff;\n  }\n\n  /* ===== Panels ===== */\n  .ps-faq__panel { display: none; }\n  .ps-faq__panel.is-active { display: block; }\n\n  /* ===== Accordion items ===== */\n  .ps-faq__item {\n    border-bottom: 1px solid rgba(23, 23, 23, 0.15);\n  }\n  .ps-faq__item:first-child {\n    border-top: 1px solid rgba(23, 23, 23, 0.15);\n  }\n  .ps-faq__q {\n    width: 100%;\n    appearance: none;\n    border: 0;\n    background-color: transparent;\n    padding: 22px 8px 22px 0;\n    text-align: left;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 14.5px;\n    font-weight: 700;\n    color: #171717;\n    text-transform: uppercase;\n    letter-spacing: 0.02em;\n    line-height: 1.3;\n    transition: color 0.2s ease;\n  }\n  .ps-faq__q:hover { color: #56C4AE; }\n  .ps-faq__q-icon {\n    flex: 0 0 24px;\n    width: 24px;\n    height: 24px;\n    position: relative;\n    transition: transform 0.3s ease;\n  }\n  .ps-faq__q-icon::before,\n  .ps-faq__q-icon::after {\n    content: \"\";\n    position: absolute;\n    background-color: #171717;\n    transition: transform 0.3s ease, background-color 0.2s ease;\n  }\n  /* horizontale */\n  .ps-faq__q-icon::before {\n    top: 50%;\n    left: 0;\n    right: 0;\n    height: 2px;\n    transform: translateY(-50%);\n  }\n  /* verticale */\n  .ps-faq__q-icon::after {\n    left: 50%;\n    top: 0;\n    bottom: 0;\n    width: 2px;\n    transform: translateX(-50%);\n  }\n  /* État ouvert : la verticale disparaît → reste un trait horizontal (=) */\n  .ps-faq__item.is-open .ps-faq__q-icon::after {\n    transform: translateX(-50%) scaleY(0);\n  }\n  .ps-faq__item.is-open .ps-faq__q { color: #171717; }\n\n  .ps-faq__a {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n  .ps-faq__a-inner {\n    padding: 0 8px 22px 0;\n    font-family: \"Red Hat Display\", sans-serif;\n    font-size: 14px;\n    font-weight: 400;\n    line-height: 1.55;\n    color: #2D2D2D;\n  }\n  .ps-faq__a-inner p {\n    margin: 0 0 12px;\n  }\n  .ps-faq__a-inner p:last-child { margin-bottom: 0; }\n  .ps-faq__a-inner strong { font-weight: 700; }\n  .ps-faq__a-inner ul {\n    margin: 8px 0 12px;\n    padding-left: 20px;\n  }\n  .ps-faq__a-inner ul li { margin: 0 0 6px; }\n\n  /* ===== Mobile ===== */\n  @media (max-width: 640px) {\n    .ps-faq { padding: 50px 20px; }\n    .ps-faq__title { font-size: clamp(26px, 8vw, 36px); margin-bottom: 28px; }\n\n    .ps-faq__tabs {\n      padding: 4px;\n      margin-bottom: 28px;\n      max-width: 100%;\n      overflow-x: auto;\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n    .ps-faq__tabs::-webkit-scrollbar { display: none; }\n    .ps-faq__tab {\n      padding: 9px 14px;\n      font-size: 11px;\n      letter-spacing: 0.04em;\n    }\n\n    .ps-faq__q {\n      font-size: 12.5px;\n      padding: 18px 4px 18px 0;\n      gap: 12px;\n    }\n    .ps-faq__q-icon {\n      flex-basis: 20px;\n      width: 20px;\n      height: 20px;\n    }\n    .ps-faq__a-inner {\n      font-size: 13.5px;\n      padding-bottom: 18px;\n    }\n  }\n</style>\n\n<section class=\"ps-faq\" data-ps-faq>\n  <div class=\"ps-faq__inner\">\n\n    <h2 class=\"ps-faq__title\">Vos questions</h2>\n\n    {%- comment -%} ===== Onglets ===== {%- endcomment -%}\n    <div class=\"ps-faq__tabs-wrap\">\n      <div class=\"ps-faq__tabs\" role=\"tablist\">\n        <button type=\"button\"\n                class=\"ps-faq__tab is-active\"\n                role=\"tab\"\n                aria-selected=\"true\"\n                data-ps-faq-tab=\"montre\">Votre montre</button>\n        <button type=\"button\"\n                class=\"ps-faq__tab\"\n                role=\"tab\"\n                aria-selected=\"false\"\n                data-ps-faq-tab=\"livraison\">Envoi & livraison</button>\n        <button type=\"button\"\n                class=\"ps-faq__tab\"\n                role=\"tab\"\n                aria-selected=\"false\"\n                data-ps-faq-tab=\"concept\">Notre concept</button>\n      </div>\n    </div>\n\n    {%- comment -%} ===== Panel \"Votre montre\" ===== {%- endcomment -%}\n    <div class=\"ps-faq__panel is-active\" data-ps-faq-panel=\"montre\" role=\"tabpanel\">\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Comment régler la taille de ma montre&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Nos montres sont livrées avec un kit de réglage pour ajuster le bracelet à votre poignet. Il vous suffit de suivre les instructions&nbsp;: même sans expérience, cela ne vous prendra pas plus de cinq minutes.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Comment personnaliser ma montre&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Vous avez trois solutions&nbsp;:</p>\n            <ul>\n              <li>Acheter de nouveaux bracelets dans notre collection accessoires.</li>\n              <li>Personnaliser le logo en contactant notre service client pour avoir une montre sans logo ou avec un logo sur mesure.</li>\n              <li>Utiliser notre configurateur pour créer une montre étape par étape en choisissant chaque composant.</li>\n            </ul>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Durée de garantie de ma montre&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Toutes les montres PROSE sont garanties pendant <strong>trois ans</strong>. Cette garantie couvre les défauts de fonctionnement non liés à une mauvaise utilisation, à un choc ou à une usure anormale de la montre.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Ma montre est-elle étanche&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Par défaut, toutes les montres PROSE sont résistantes à l'eau.</p>\n            <p>Avec l'option <strong>étanchéité renforcée</strong>, vous pouvez porter votre montre lors d'une baignade, jusqu'à 5 mètres de profondeur maximum.</p>\n            <p>Avant tout contact avec l'eau, veillez toujours à bien visser la couronne. Nous déconseillons toutefois de plonger avec votre montre.</p>\n            <p>L'étanchéité doit être contrôlée tous les 12 mois pour maintenir la garantie. Notre service client pourra vous accompagner si vous souhaitez faire réaliser ce contrôle.</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    {%- comment -%} ===== Panel \"Envoi & livraison\" ===== {%- endcomment -%}\n    <div class=\"ps-faq__panel\" data-ps-faq-panel=\"livraison\" role=\"tabpanel\" hidden>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Quelle est la durée de livraison&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Chaque montre est assemblée manuellement après votre commande. Comptez environ <strong>5 à 7 jours ouvrés</strong> pour la préparation des pièces, l'assemblage et le contrôle qualité, selon le volume de commandes.</p>\n            <p>Après expédition, la livraison avec Colissimo prend généralement 3 à 5 jours ouvrés.</p>\n            <p>En moyenne, vous recevez donc votre montre sous <strong>8 à 12 jours ouvrés</strong> après votre commande.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Puis-je retourner mon modèle&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Vous disposez de <strong>30 jours</strong> à compter de la livraison pour retourner votre montre automatique.</p>\n            <p>Le remboursement est effectué sous 5 à 7 jours ouvrés après réception du retour.</p>\n            <p>Veuillez noter que les montres personnalisées sur demande ne sont pas éligibles au retour.</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n    {%- comment -%} ===== Panel \"Notre concept\" ===== {%- endcomment -%}\n    <div class=\"ps-faq__panel\" data-ps-faq-panel=\"concept\" role=\"tabpanel\" hidden>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Le concept Prose&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>C'est une montre assemblée à la main, équipée d'un mouvement automatique, avec des pièces dont le design s'inspire de modèles iconiques.</p>\n            <p>Notre objectif&nbsp;: vous offrir <strong>le meilleur rapport qualité-prix possible</strong> pour une montre automatique de qualité, sans dépendre d'un budget inaccessible.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Comment se passe l'assemblage d'une montre&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Chaque montre est assemblée après votre commande.</p>\n            <p>Nous produisons et stockons les pièces détachées nécessaires à sa fabrication. Nos horlogers réunissent ensuite les composants de votre montre, procèdent à son assemblage, puis la confient à notre partenaire logistique, chargé de vous l'expédier.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Où sont situés vos ateliers&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Nous disposons de plusieurs ateliers afin de répondre à une demande internationale, notamment en <strong>Chine</strong>, en <strong>Espagne</strong> et en <strong>France</strong>.</p>\n            <p>En France, nous travaillons avec deux ateliers indépendants partenaires&nbsp;: l'un à <strong>Paris</strong>, dans le 17e arrondissement, et l'autre à <strong>Metz</strong>, dans l'est de la France.</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"ps-faq__item\">\n        <button type=\"button\" class=\"ps-faq__q\" data-ps-faq-q aria-expanded=\"false\">\n          Puis-je demander un assemblage en France&nbsp;?\n          <span class=\"ps-faq__q-icon\" aria-hidden=\"true\"></span>\n        </button>\n        <div class=\"ps-faq__a\">\n          <div class=\"ps-faq__a-inner\">\n            <p>Par défaut, nous privilégions un assemblage en France pour nos clients français.</p>\n            <p>Pour le garantir, vous pouvez le préciser à notre service client ou sélectionner l'option <strong>«&nbsp;Assemblage Made in France &amp; étanchéité renforcée&nbsp;»</strong>.</p>\n            <p>Dans tous les cas, nos exigences qualité restent les mêmes, quel que soit l'atelier d'assemblage.</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<script>\n  (function() {\n    'use strict';\n    var root = document.querySelector('[data-ps-faq]');\n    if (!root) return;\n\n    /* ===== Onglets ===== */\n    var tabs = root.querySelectorAll('[data-ps-faq-tab]');\n    var panels = root.querySelectorAll('[data-ps-faq-panel]');\n\n    function activateTab(name) {\n      tabs.forEach(function(t) {\n        var isThis = t.getAttribute('data-ps-faq-tab') === name;\n        t.classList.toggle('is-active', isThis);\n        t.setAttribute('aria-selected', isThis ? 'true' : 'false');\n      });\n      panels.forEach(function(p) {\n        var isThis = p.getAttribute('data-ps-faq-panel') === name;\n        p.classList.toggle('is-active', isThis);\n        if (isThis) {\n          p.removeAttribute('hidden');\n        } else {\n          p.setAttribute('hidden', '');\n        }\n      });\n      /* Ferme tous les items ouverts lors du changement d'onglet */\n      root.querySelectorAll('.ps-faq__item.is-open').forEach(function(it) {\n        it.classList.remove('is-open');\n        var a = it.querySelector('.ps-faq__a');\n        if (a) a.style.maxHeight = '0px';\n        var q = it.querySelector('.ps-faq__q');\n        if (q) q.setAttribute('aria-expanded', 'false');\n      });\n    }\n\n    tabs.forEach(function(t) {\n      t.addEventListener('click', function() {\n        activateTab(t.getAttribute('data-ps-faq-tab'));\n      });\n    });\n\n    /* ===== Accordion ===== */\n    var items = root.querySelectorAll('.ps-faq__item');\n\n    function closeAllExcept(except) {\n      items.forEach(function(it) {\n        if (it === except) return;\n        if (!it.classList.contains('is-open')) return;\n        it.classList.remove('is-open');\n        var a = it.querySelector('.ps-faq__a');\n        if (a) a.style.maxHeight = '0px';\n        var q = it.querySelector('.ps-faq__q');\n        if (q) q.setAttribute('aria-expanded', 'false');\n      });\n    }\n\n    items.forEach(function(it) {\n      var q = it.querySelector('.ps-faq__q');\n      var a = it.querySelector('.ps-faq__a');\n      if (!q || !a) return;\n      q.addEventListener('click', function() {\n        var willOpen = !it.classList.contains('is-open');\n        closeAllExcept(it);\n        it.classList.toggle('is-open', willOpen);\n        q.setAttribute('aria-expanded', willOpen ? 'true' : 'false');\n        a.style.maxHeight = willOpen ? a.scrollHeight + 'px' : '0px';\n      });\n    });\n  })();\n</script>",
